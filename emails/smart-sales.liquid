<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ ss_bg }}" style="background-color:{{ ss_bg }};">

  <!-- ===================== PASTILĂ + TITLU ===================== -->
  <tr>
    <td align="center" style="padding:32px 20px 0 20px;text-align:center;">
      <span style="display:inline-block;border:1px solid {{ ss_teal }};border-radius:999px;padding:6px 14px;font-family:{{ ss_font }};font-size:12px;line-height:14px;font-weight:700;letter-spacing:2px;color:{{ ss_teal }};text-transform:uppercase;"><span style="font-size:14px;">&#9679;</span>&nbsp; {{ ss_pill | upcase }}</span>
      <div style="padding-top:16px;font-family:{{ ss_font }};font-size:36px;line-height:42px;font-weight:800;color:#FFFFFF;">{{ ss_title }}</div>
      <div style="padding-top:6px;font-family:{{ ss_font }};font-size:22px;line-height:29px;font-weight:700;color:#FFFFFF;">{{ ss_sub_1 }} <span style="color:{{ ss_teal }};white-space:nowrap;">{{ ss_sub_2 }}</span></div>
      <div style="max-width:470px;margin:0 auto;padding-top:12px;font-family:{{ ss_font }};font-size:15px;line-height:23px;font-weight:400;color:#A3A6A8;">{{ ss_text }}</div>
    </td>
  </tr>

  <!-- ===================== BILET ===================== -->
  <tr>
    <td align="center" style="padding:26px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="440" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:440px;vertical-align:top;background-color:{{ ss_box }};border:1px solid {{ ss_box_line }};border-radius:16px;overflow:hidden;text-align:left;">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
          <tr>
            <td class="ss-tk-l" valign="middle" style="padding:18px 14px 18px 22px;">
              <div style="font-family:{{ ss_font }};font-size:10px;line-height:14px;font-weight:700;letter-spacing:1.5px;color:{{ ss_teal }};text-transform:uppercase;">{{ ss_tk_top | upcase }}</div>
              <div class="ss-tk-name" style="padding-top:4px;font-family:{{ ss_font }};font-size:28px;line-height:34px;font-weight:800;color:#FFFFFF;">{{ ss_tk_name }}</div>
              <div style="padding-top:6px;font-family:{{ ss_font }};font-size:12px;line-height:18px;font-weight:400;color:#A3A6A8;">{{ ss_tk_info_1 }}<br>{{ ss_tk_info_2 }}</div>
            </td>
            <td width="36%" align="center" valign="middle" bgcolor="{{ ss_teal }}" style="width:36%;background-color:{{ ss_teal }};border-left:3px dashed {{ ss_box }};border-radius:0 15px 15px 0;padding:14px 6px;text-align:center;">
              <div style="padding-left:1.5px;font-family:{{ ss_font }};font-size:11px;line-height:14px;font-weight:700;letter-spacing:1.5px;color:#000000;text-align:center;text-transform:uppercase;">{{ ss_tk_small | upcase }}</div>
              <div class="ss-tk-big" style="padding-top:2px;font-family:{{ ss_font }};font-size:40px;line-height:44px;font-weight:800;color:#000000;text-align:center;white-space:nowrap;"><span style="display:inline-block;width:0.87em;font-size:22px;line-height:22px;"></span>{{ ss_tk_big }}<span style="font-size:22px;line-height:22px;vertical-align:top;">%</span></div>
            </td>
          </tr>
        </table>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== PRODUSE ===================== -->
  <tr>
    <td align="center" style="padding:32px 20px 0 20px;text-align:center;">
      <div style="font-family:{{ ss_font }};font-size:20px;line-height:26px;font-weight:700;color:#FFFFFF;">{{ ss_grid_head }}</div>
      <div style="padding-top:6px;font-family:{{ ss_font }};font-size:14px;line-height:20px;font-weight:400;color:#A3A6A8;">{{ ss_grid_text }}</div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 6px 0 6px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign ss_n = 0 -%}
        {%- for ss_item in ss_lista -%}
          {%- unless ss_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign ss_f      = ss_item | split: "|" -%}
          {%- assign ss_cat    = ss_f[0] | strip | upcase | escape -%}
          {%- assign ss_vendor = ss_f[1] | strip | replace: "_", " " | upcase | truncate: 20, "…" | escape -%}
          {%- assign ss_title2 = ss_f[2] | strip -%}
          {%- if ss_title2.size > ss_title_max -%}
            {%- assign ss_cut   = ss_title2 | slice: 0, ss_title_max -%}
            {%- assign ss_words = ss_cut | split: " " -%}
            {%- assign ss_title2 = "" -%}
            {%- for ss_w in ss_words -%}
              {%- unless forloop.last -%}{%- assign ss_title2 = ss_title2 | append: ss_w | append: " " -%}{%- endunless -%}
            {%- endfor -%}
            {%- assign ss_title2 = ss_title2 | strip -%}
            {%- assign ss_lc = ss_title2 | slice: -1 -%}
            {%- if ss_lc == "+" or ss_lc == "," or ss_lc == "-" or ss_lc == "–" or ss_lc == ":" or ss_lc == "(" -%}
              {%- assign ss_len    = ss_title2.size | minus: 1 -%}
              {%- assign ss_title2 = ss_title2 | slice: 0, ss_len | strip -%}
            {%- endif -%}
            {%- if ss_title2 == "" -%}{%- assign ss_title2 = ss_cut -%}{%- endif -%}
            {%- assign ss_title2 = ss_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign ss_title2 = ss_title2 | escape -%}
          {%- assign ss_alt    = ss_f[2] | strip | escape -%}
          {%- assign ss_img    = ss_f[3] | strip -%}
          {%- assign ss_url    = ss_f[4] | strip -%}
          {%- assign ss_p_new  = ss_f[5] | strip -%}
          {%- assign ss_p_old  = ss_f[6] | strip -%}
          {%- assign ss_new_n  = ss_p_new | plus: 0 -%}
          {%- assign ss_old_n  = ss_p_old | plus: 0 -%}
          {%- assign ss_badge  = "Smart Sales" -%}
          {%- if ss_show_prices and ss_old_n > ss_new_n -%}
            {%- assign ss_pct   = ss_old_n | minus: ss_new_n | times: 100 | divided_by: ss_old_n | round -%}
            {%- assign ss_badge = "-" | append: ss_pct | append: "%" -%}
          {%- endif -%}
          {%- assign ss_p_new_txt = ss_p_new | replace: ".", "," | append: " " | append: ss_currency -%}
          {%- assign ss_p_old_txt = ss_p_old | replace: ".", "," | append: " " | append: ss_currency -%}
          {%- assign ss_n      = ss_n | plus: 1 -%}
          {%- assign ss_mod    = ss_n | modulo: 3 -%}
          {%- if ss_n > 1 and ss_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="180" valign="top"><![endif]-->
          <div class="ss-col" style="display:inline-block;width:100%;max-width:180px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="ss-card" style="background-color:#FFFFFF;border-radius:14px;padding:10px;">
                <!-- categoria -->
                <div class="ss-cat" style="background-color:#000000;border-radius:8px;padding:6px 4px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;text-align:center;font-family:{{ ss_font }};font-size:10px;line-height:12px;font-weight:700;letter-spacing:1px;color:{{ ss_teal }};">&#9733;&nbsp; {{ ss_cat }}</div>
                <!-- badge reducere -->
                <div style="padding-top:8px;"><span style="display:inline-block;background-color:{{ ss_red }};border-radius:7px;padding:4px 8px;font-family:{{ ss_font }};font-size:13px;line-height:15px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ ss_badge }}</span></div>
                <!-- imagine -->
                <div style="margin-top:6px;height:132px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ ss_url }}" target="_blank" style="text-decoration:none;"><img src="{{ ss_img }}" width="132" alt="{{ ss_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:132px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <!-- brand -->
                <div style="padding-top:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ ss_font }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:1px;color:#646C71;">{{ ss_vendor }}</div>
                <!-- titlu (max. 2 rânduri) -->
                <div style="margin-top:6px;height:38px;overflow:hidden;font-family:{{ ss_font }};font-size:13px;line-height:19px;font-weight:400;color:#404040;"><a href="{{ ss_url }}" target="_blank" style="color:#404040;text-decoration:none;">{{ ss_title2 }}</a></div>
                {%- if ss_show_prices %}
                <!-- preț -->
                <div class="ss-price" style="padding-top:8px;white-space:nowrap;font-family:{{ ss_font }};font-size:16px;line-height:20px;font-weight:800;color:{{ ss_red }};">{{ ss_p_new_txt }}{% if ss_old_n > ss_new_n %} <span class="ss-old" style="font-size:12px;font-weight:400;color:#8A9095;text-decoration:line-through;">{{ ss_p_old_txt }}</span>{% endif %}</div>
                {%- endif %}
                <!-- buton card -->
                <div style="padding-top:10px;">
                  <div style="background-color:#000000;border-radius:8px;text-align:center;overflow:hidden;">
                    <a class="ss-cta" href="{{ ss_url }}" target="_blank" style="display:block;padding:10px 6px;font-family:{{ ss_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;">{{ ss_card_cta }}&nbsp;<span style="color:{{ ss_teal }};font-family:Arial,Helvetica,sans-serif;">&#8594;</span></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== CÂT MAI AVEM STOC ===================== -->
  <tr>
    <td align="center" style="padding:22px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:left;">
        <div style="border:1px solid {{ ss_teal }};border-radius:14px;padding:14px 18px;">
