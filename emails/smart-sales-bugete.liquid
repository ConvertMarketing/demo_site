<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ sb_bg }}" style="background-color:{{ sb_bg }};">

  <!-- ===================== TITLU + INDEX ===================== -->
  <tr>
    <td class="sb-wrap" align="center" style="padding:32px 16px 0 16px;text-align:center;">
      <span style="display:inline-block;border:1px solid {{ sb_teal }};border-radius:999px;padding:6px 14px;font-family:{{ sb_font }};font-size:12px;line-height:14px;font-weight:700;letter-spacing:1.5px;color:{{ sb_teal }};text-transform:uppercase;"><span style="font-size:14px;">&#9679;</span>&nbsp; {{ sb_pill | upcase }}</span>
      <div class="sb-h1" style="padding-top:16px;font-family:{{ sb_font }};font-size:36px;line-height:42px;font-weight:800;color:{{ sb_head }};">{{ sb_title_1 }}<br><span style="color:{{ sb_teal }};">{{ sb_title_2 }}</span></div>
      <div style="padding-top:12px;font-size:0;line-height:0;"><div style="display:inline-block;max-width:470px;vertical-align:top;font-family:{{ sb_font }};font-size:15px;line-height:23px;font-weight:400;color:{{ sb_muted }};">{{ sb_text }}</div></div>
      <div style="max-width:580px;margin:0 auto;padding-top:20px;font-size:0;line-height:0;text-align:center;">
        <!--[if mso]><table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
        {%- for sb_x in sb_index_list -%}
          {%- unless sb_x contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sb_xp = sb_x | split: "|" %}
        <!--[if mso]><td width="145" valign="top"><![endif]-->
        <div style="display:inline-block;width:25%;vertical-align:top;">
          <div style="padding:0 3px;">
            <div style="background-color:{{ sb_tile }};border:1px solid {{ sb_tile_line }};border-radius:14px;padding:10px 2px 11px 2px;text-align:center;">
              <div style="font-family:{{ sb_font }};font-size:10px;line-height:13px;font-weight:700;letter-spacing:1px;color:{{ sb_muted }};text-transform:uppercase;white-space:nowrap;">{{ sb_xp[0] | strip }}</div>
              <div class="sb-idx-big" style="padding-top:2px;font-family:{{ sb_font }};font-size:20px;line-height:24px;font-weight:800;color:{{ sb_teal }};">{{ sb_xp[1] | strip }}</div>
            </div>
          </div>
        </div>
        <!--[if mso]></td><![endif]-->
        {%- endfor %}
        <!--[if mso]></tr></table><![endif]-->
      </div>
    </td>
  </tr>

  <!-- ===================== BUGETE ===================== -->
  {%- for sb_b in sb_bugete -%}
    {%- assign sb_parts = sb_b | split: "##" -%}
    {%- if sb_parts.size < 2 -%}{%- continue -%}{%- endif -%}
    {%- assign sb_hdr  = sb_parts[0] | append: " | " | split: "|" -%}
    {%- assign sb_name = sb_hdr[0] | strip -%}
    {%- assign sb_desc = sb_hdr[1] | strip %}
  <tr>
    <td class="sb-wrap" align="left" style="padding:34px 22px 0 22px;text-align:left;">
      <div style="font-family:{{ sb_font }};font-size:22px;line-height:28px;font-weight:800;color:{{ sb_head }};"><span style="display:inline-block;width:5px;height:20px;background-color:{{ sb_teal }};border-radius:3px;vertical-align:-2px;">&nbsp;</span>&nbsp; {{ sb_name }}</div>
      <div style="padding-top:2px;font-family:{{ sb_font }};font-size:14px;line-height:20px;font-weight:400;color:{{ sb_muted }};">{{ sb_desc }}</div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:10px 10px 0 10px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign sb_n = 0 -%}
        {%- for sb_item in sb_parts offset:1 -%}
          {%- unless sb_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sb_f      = sb_item | append: " | | | " | split: "|" -%}
          {%- assign sb_title2 = sb_f[0] | strip -%}
          {%- if sb_title2.size > sb_title_max -%}
            {%- assign sb_cut   = sb_title2 | slice: 0, sb_title_max -%}
            {%- assign sb_next  = sb_title2 | slice: sb_title_max, 1 -%}
            {%- assign sb_last  = sb_cut | slice: -1 -%}
            {%- if sb_next == " " or sb_last == " " -%}
              {%- assign sb_title2 = sb_cut | strip -%}
            {%- else -%}
              {%- assign sb_words = sb_cut | split: " " -%}
              {%- assign sb_title2 = "" -%}
              {%- for sb_w in sb_words -%}
                {%- unless forloop.last -%}{%- assign sb_title2 = sb_title2 | append: sb_w | append: " " -%}{%- endunless -%}
              {%- endfor -%}
              {%- assign sb_title2 = sb_title2 | strip -%}
            {%- endif -%}
            {%- assign sb_lc = sb_title2 | slice: -1 -%}
            {%- if sb_lc == "+" or sb_lc == "," or sb_lc == "-" or sb_lc == "–" or sb_lc == ":" or sb_lc == "(" -%}
              {%- assign sb_len    = sb_title2.size | minus: 1 -%}
              {%- assign sb_title2 = sb_title2 | slice: 0, sb_len | strip -%}
            {%- endif -%}
            {%- if sb_title2 == "" -%}{%- assign sb_title2 = sb_cut -%}{%- endif -%}
            {%- assign sb_title2 = sb_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign sb_title2 = sb_title2 | escape -%}
          {%- assign sb_alt    = sb_f[0] | strip | escape -%}
          {%- assign sb_img    = sb_f[1] | strip -%}
          {%- assign sb_purl   = sb_f[2] | strip -%}
          {%- assign sb_vid    = sb_f[3] | strip -%}
          {%- assign sb_nc     = sb_f[4] | strip | times: 100 | round -%}
          {%- assign sb_oc     = sb_f[5] | strip | times: 100 | round -%}
          {%- assign sb_rate   = sb_f[6] | strip -%}
          {%- assign sb_revs   = sb_f[7] | strip -%}
          {%- assign sb_sc     = 0 -%}
          {%- assign sb_badge  = "Smart Sales" -%}
          {%- if sb_oc > sb_nc -%}
            {%- assign sb_sc    = sb_oc | minus: sb_nc -%}
            {%- assign sb_pct   = sb_sc | times: 100.0 | divided_by: sb_oc | round -%}
            {%- assign sb_badge = "-" | append: sb_pct | append: "%" -%}
          {%- endif -%}
          {%- comment -%} formatare prețuri: 15999 → 159,99 ; 434673 → 4.346,73 {%- endcomment -%}
          {%- assign sb_fmt_in  = sb_nc | append: "~" | append: sb_oc | append: "~" | append: sb_sc | split: "~" -%}
          {%- assign sb_fmt_out = "" -%}
          {%- for sb_v in sb_fmt_in -%}
            {%- assign sb_c  = sb_v | plus: 0 -%}
            {%- assign sb_i  = sb_c | divided_by: 100 | floor -%}
            {%- assign sb_d  = sb_c | modulo: 100 -%}
            {%- if sb_d < 10 -%}{%- assign sb_ds = sb_d | prepend: "0" -%}{%- else -%}{%- assign sb_ds = sb_d | append: "" -%}{%- endif -%}
            {%- if sb_i >= 1000 -%}
              {%- assign sb_th = sb_i | divided_by: 1000 | floor -%}
              {%- assign sb_r  = sb_i | modulo: 1000 -%}
              {%- if sb_r < 10 -%}{%- assign sb_rs = sb_r | prepend: "00" -%}{%- elsif sb_r < 100 -%}{%- assign sb_rs = sb_r | prepend: "0" -%}{%- else -%}{%- assign sb_rs = sb_r | append: "" -%}{%- endif -%}
              {%- assign sb_is = sb_th | append: "." | append: sb_rs -%}
            {%- else -%}
              {%- assign sb_is = sb_i | append: "" -%}
            {%- endif -%}
            {%- assign sb_fmt_out = sb_fmt_out | append: sb_is | append: "," | append: sb_ds | append: "~" -%}
          {%- endfor -%}
          {%- assign sb_pf = sb_fmt_out | split: "~" -%}
          {%- assign sb_full = 0 -%}
          {%- if sb_rate != "" -%}{%- assign sb_full = sb_rate | plus: 0 | round -%}{%- endif -%}
          {%- assign sb_rate_txt = sb_rate | replace: ".", "," -%}
          {%- assign sb_add = sb_shop | append: "/cart/add?id=" | append: sb_vid | append: "&quantity=1" -%}
          {%- assign sb_n   = sb_n | plus: 1 -%}
          {%- assign sb_mod = sb_n | modulo: 2 -%}
          {%- if sb_n > 1 and sb_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="270" valign="top"><![endif]-->
          <div class="sb-col" style="display:inline-block;width:50%;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="sb-card" style="background-color:#FFFFFF;border:1px solid {{ sb_line }};border-radius:16px;padding:12px;">
                <div style="font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ sb_red }};border-radius:7px;padding:3px 8px;font-family:{{ sb_font }};font-size:13px;line-height:16px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ sb_badge }}</span></div>
                <div class="sb-imgbox" style="margin-top:4px;height:160px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ sb_purl }}" target="_blank" style="text-decoration:none;"><img class="sb-img" src="{{ sb_img }}" width="160" alt="{{ sb_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:160px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <div class="sb-title" style="margin-top:10px;height:36px;overflow:hidden;font-family:{{ sb_font }};font-size:12px;line-height:18px;font-weight:600;color:{{ sb_ink }};"><a href="{{ sb_purl }}" target="_blank" style="color:{{ sb_ink }};text-decoration:none;line-height:inherit;">{{ sb_title2 }}</a></div>
                <div style="margin-top:5px;height:16px;overflow:hidden;white-space:nowrap;font-family:{{ sb_font }};font-size:12px;line-height:16px;font-weight:400;color:#5F676C;">{% if sb_full > 0 %}<span class="sb-stars" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:1px;color:{{ sb_star }};">{% for sb_s in (1..5) %}{% if sb_s <= sb_full %}&#9733;{% else %}<span style="color:#D3D9DB;">&#9733;</span>{% endif %}{% endfor %}</span>&nbsp;<span style="font-weight:700;color:{{ sb_ink }};">{{ sb_rate_txt }}</span>{% if sb_revs != "" %} ({{ sb_revs }}){% endif %}{% else %}&nbsp;{% endif %}</div>
                <div style="padding-top:6px;white-space:nowrap;font-family:{{ sb_font }};font-size:12px;line-height:15px;font-weight:400;color:#8A9095;">{% if sb_oc > sb_nc %}<span style="text-decoration:line-through;">{{ sb_pf[1] }} {{ sb_currency }}</span>{% else %}&nbsp;{% endif %}</div>
                <div class="sb-price" style="white-space:nowrap;font-family:{{ sb_font }};font-size:19px;line-height:24px;font-weight:800;color:{{ sb_red }};">{{ sb_pf[0] }} {{ sb_currency }}</div>
                <!-- economisești -->
                <div style="margin-top:8px;background-color:{{ sb_teal_soft }};border-radius:10px;padding:6px 8px;">
                  <div style="font-family:{{ sb_font }};font-size:9.5px;line-height:12px;font-weight:700;letter-spacing:1px;color:{{ sb_teal_dark }};text-transform:uppercase;white-space:nowrap;">{{ sb_save_lbl | upcase }}</div>
                  <div class="sb-save-amt" style="font-family:{{ sb_font }};font-size:15px;line-height:19px;font-weight:800;color:{{ sb_teal_dark }};white-space:nowrap;">{% if sb_sc > 0 %}{{ sb_pf[2] }} {{ sb_currency }}{% else %}&nbsp;{% endif %}</div>
                </div>
                <!-- buton -->
                <div style="padding-top:10px;">
                  <div style="background-color:{{ sb_ink }};border-radius:999px;text-align:center;overflow:hidden;">
                    <a class="sb-cta" href="{{ sb_add }}" target="_blank" style="display:block;padding:10px 6px;font-family:{{ sb_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;"><span style="font-family:Arial,Helvetica,sans-serif;color:{{ sb_teal }};">+</span>&nbsp;{{ sb_card_cta }}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>
  {%- endfor %}

  <!-- ===================== SE ÎNCHEIE + BUTON ===================== -->
  <tr>
    <td class="sb-wrap" align="center" style="padding:30px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
