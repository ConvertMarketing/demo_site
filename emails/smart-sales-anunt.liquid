<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ sa_bg }}" style="background-color:{{ sa_bg }};">
  <tr>
    <td class="sa-wrap" align="center" style="padding:30px 16px 0 16px;text-align:center;">

      <!-- ===================== TITLU ===================== -->
      <div class="sa-intro" style="font-family:{{ sa_font }};font-size:24px;line-height:30px;font-weight:800;color:{{ sa_head }};">{{ sa_intro_title }}</div>
      <div style="padding-top:8px;font-size:0;line-height:0;"><div style="display:inline-block;max-width:460px;vertical-align:top;font-family:{{ sa_font }};font-size:15px;line-height:23px;font-weight:400;color:{{ sa_muted }};">{{ sa_intro_text }}</div></div>

      <!-- ===================== CIFRE ===================== -->
      <div style="max-width:580px;margin:0 auto;padding-top:20px;font-size:0;line-height:0;text-align:center;">
        <!--[if mso]><table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
        {%- for sa_s in sa_stat_list -%}
          {%- unless sa_s contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sa_sp = sa_s | split: "|" %}
        <!--[if mso]><td width="193" valign="top"><![endif]-->
        <div style="display:inline-block;width:33.33%;vertical-align:top;">
          <div style="padding:0 4px;">
            <div style="background-color:{{ sa_tile }};border:1px solid {{ sa_tile_line }};border-radius:16px;padding:14px 4px 12px 4px;text-align:center;">
              <div class="sa-stat-num" style="font-family:{{ sa_font }};font-size:28px;line-height:34px;font-weight:800;color:{{ sa_teal }};white-space:nowrap;">{{ sa_sp[0] | strip }}</div>
              <div class="sa-stat-lbl" style="padding-top:2px;font-family:{{ sa_font }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0.5px;color:{{ sa_muted }};text-transform:uppercase;">{{ sa_sp[1] | strip }}</div>
            </div>
          </div>
        </div>
        <!--[if mso]></td><![endif]-->
        {%- endfor %}
        <!--[if mso]></tr></table><![endif]-->
      </div>

      <!-- ===================== PRODUSE ===================== -->
      <div style="padding-top:34px;text-align:center;">
        <div style="font-family:{{ sa_font }};font-size:22px;line-height:28px;font-weight:800;color:{{ sa_head }};">{{ sa_list_head }}</div>
        <div style="padding-top:6px;font-family:{{ sa_font }};font-size:14px;line-height:20px;font-weight:400;color:{{ sa_muted }};">{{ sa_list_text }}</div>
      </div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 6px 0 6px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign sa_n = 0 -%}
        {%- for sa_item in sa_lista -%}
          {%- unless sa_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sa_f      = sa_item | append: " | | | " | split: "|" -%}
          {%- assign sa_cat    = sa_f[0] | strip | upcase | escape -%}
          {%- assign sa_title2 = sa_f[1] | strip -%}
          {%- if sa_title2.size > sa_title_max -%}
            {%- assign sa_cut   = sa_title2 | slice: 0, sa_title_max -%}
            {%- assign sa_next  = sa_title2 | slice: sa_title_max, 1 -%}
            {%- assign sa_last  = sa_cut | slice: -1 -%}
            {%- if sa_next == " " or sa_last == " " -%}
              {%- assign sa_title2 = sa_cut | strip -%}
            {%- else -%}
              {%- assign sa_words = sa_cut | split: " " -%}
              {%- assign sa_title2 = "" -%}
              {%- for sa_w in sa_words -%}
                {%- unless forloop.last -%}{%- assign sa_title2 = sa_title2 | append: sa_w | append: " " -%}{%- endunless -%}
              {%- endfor -%}
              {%- assign sa_title2 = sa_title2 | strip -%}
            {%- endif -%}
            {%- assign sa_lc = sa_title2 | slice: -1 -%}
            {%- if sa_lc == "+" or sa_lc == "," or sa_lc == "-" or sa_lc == "–" or sa_lc == ":" or sa_lc == "(" -%}
              {%- assign sa_len    = sa_title2.size | minus: 1 -%}
              {%- assign sa_title2 = sa_title2 | slice: 0, sa_len | strip -%}
            {%- endif -%}
            {%- if sa_title2 == "" -%}{%- assign sa_title2 = sa_cut -%}{%- endif -%}
            {%- assign sa_title2 = sa_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign sa_title2 = sa_title2 | escape -%}
          {%- assign sa_alt    = sa_f[1] | strip | escape -%}
          {%- assign sa_img    = sa_f[2] | strip -%}
          {%- assign sa_url    = sa_f[3] | strip -%}
          {%- assign sa_new_c  = sa_f[4] | strip | times: 100 | round -%}
          {%- assign sa_old_c  = sa_f[5] | strip | times: 100 | round -%}
          {%- assign sa_rate   = sa_f[6] | strip -%}
          {%- assign sa_revs   = sa_f[7] | strip -%}
          {%- assign sa_badge  = "Smart Sales" -%}
          {%- if sa_old_c > sa_new_c -%}
            {%- assign sa_pct   = sa_old_c | minus: sa_new_c | times: 100.0 | divided_by: sa_old_c | round -%}
            {%- assign sa_badge = "-" | append: sa_pct | append: "%" -%}
          {%- endif -%}
          {%- comment -%} formatare prețuri: 15999 → 159,99 ; 434673 → 4.346,73 {%- endcomment -%}
          {%- assign sa_fmt_in  = sa_new_c | append: "~" | append: sa_old_c | split: "~" -%}
          {%- assign sa_fmt_out = "" -%}
          {%- for sa_v in sa_fmt_in -%}
            {%- assign sa_c  = sa_v | plus: 0 -%}
            {%- assign sa_i  = sa_c | divided_by: 100 | floor -%}
            {%- assign sa_d  = sa_c | modulo: 100 -%}
            {%- if sa_d < 10 -%}{%- assign sa_ds = sa_d | prepend: "0" -%}{%- else -%}{%- assign sa_ds = sa_d | append: "" -%}{%- endif -%}
            {%- if sa_i >= 1000 -%}
              {%- assign sa_th = sa_i | divided_by: 1000 | floor -%}
              {%- assign sa_r  = sa_i | modulo: 1000 -%}
              {%- if sa_r < 10 -%}{%- assign sa_rs = sa_r | prepend: "00" -%}{%- elsif sa_r < 100 -%}{%- assign sa_rs = sa_r | prepend: "0" -%}{%- else -%}{%- assign sa_rs = sa_r | append: "" -%}{%- endif -%}
              {%- assign sa_is = sa_th | append: "." | append: sa_rs -%}
            {%- else -%}
              {%- assign sa_is = sa_i | append: "" -%}
            {%- endif -%}
            {%- assign sa_fmt_out = sa_fmt_out | append: sa_is | append: "," | append: sa_ds | append: "~" -%}
          {%- endfor -%}
          {%- assign sa_pf = sa_fmt_out | split: "~" -%}
          {%- comment -%} stele: nota rotunjită (4.8 → 5) {%- endcomment -%}
          {%- assign sa_full = 0 -%}
          {%- if sa_rate != "" -%}{%- assign sa_full = sa_rate | plus: 0 | round -%}{%- endif -%}
          {%- assign sa_rate_txt = sa_rate | replace: ".", "," -%}
          {%- assign sa_n   = sa_n | plus: 1 -%}
          {%- assign sa_mod = sa_n | modulo: 3 -%}
          {%- if sa_n > 1 and sa_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="180" valign="top"><![endif]-->
          <div class="sa-col" style="display:inline-block;width:100%;max-width:180px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="sa-card" style="background-color:#FFFFFF;border:1px solid {{ sa_line }};border-radius:16px;padding:10px;">
                <!-- badge + imagine -->
                <div style="font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ sa_red }};border-radius:7px;padding:3px 7px;font-family:{{ sa_font }};font-size:12px;line-height:15px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ sa_badge }}</span></div>
                <div style="margin-top:4px;height:128px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ sa_url }}" target="_blank" style="text-decoration:none;"><img src="{{ sa_img }}" width="128" alt="{{ sa_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:128px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <!-- categorie -->
                <div class="sa-cat" style="padding-top:10px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ sa_font }};font-size:10px;line-height:13px;font-weight:700;letter-spacing:1px;color:{{ sa_teal_dark }};">{{ sa_cat }}</div>
                <!-- titlu (max. 2 rânduri) -->
                <div class="sa-title" style="margin-top:4px;height:36px;overflow:hidden;font-family:{{ sa_font }};font-size:13px;line-height:18px;font-weight:600;color:{{ sa_ink }};"><a href="{{ sa_url }}" target="_blank" style="color:{{ sa_ink }};text-decoration:none;line-height:inherit;">{{ sa_title2 }}</a></div>
                <!-- stele -->
                <div style="margin-top:5px;height:16px;overflow:hidden;white-space:nowrap;font-family:{{ sa_font }};font-size:12px;line-height:16px;font-weight:400;color:#5F676C;">{% if sa_full > 0 %}<span class="sa-stars" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:1px;color:{{ sa_star }};">{% for sa_k in (1..5) %}{% if sa_k <= sa_full %}&#9733;{% else %}<span style="color:#D3D9DB;">&#9733;</span>{% endif %}{% endfor %}</span>&nbsp;<span style="font-weight:700;color:{{ sa_ink }};">{{ sa_rate_txt }}</span>{% if sa_revs != "" %} ({{ sa_revs }}){% endif %}{% else %}&nbsp;{% endif %}</div>
                <!-- preț vechi + preț nou -->
                <div style="padding-top:6px;white-space:nowrap;font-family:{{ sa_font }};font-size:12px;line-height:15px;font-weight:400;color:#8A9095;">{% if sa_old_c > sa_new_c %}<span style="text-decoration:line-through;">{{ sa_pf[1] }} {{ sa_currency }}</span>{% else %}&nbsp;{% endif %}</div>
                <div class="sa-price" style="white-space:nowrap;font-family:{{ sa_font }};font-size:17px;line-height:22px;font-weight:800;color:{{ sa_red }};">{{ sa_pf[0] }} {{ sa_currency }}</div>
                <!-- buton card -->
                <div style="padding-top:10px;">
                  <div style="background-color:{{ sa_ink }};border-radius:999px;text-align:center;overflow:hidden;">
                    <a class="sa-cta" href="{{ sa_url }}" target="_blank" style="display:block;padding:9px 6px;font-family:{{ sa_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;">{{ sa_card_cta }}&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;color:{{ sa_teal }};">&#8594;</span></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== STOCURI ===================== -->
  <tr>
    <td class="sa-wrap" align="center" style="padding:16px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:left;">
        <div style="border:1px solid {{ sa_teal }};border-radius:18px;padding:14px 18px;background-color:{{ sa_tile }};">
          <div style="font-family:{{ sa_font }};font-size:15px;line-height:21px;font-weight:800;color:{{ sa_teal }};">{{ sa_stock_head }}</div>
          <div style="padding-top:2px;font-family:{{ sa_font }};font-size:14px;line-height:20px;font-weight:400;color:#C9CCCE;">{{ sa_stock_text }}</div>
        </div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== BUTON ===================== -->
  <tr>
    <td align="center" style="padding:26px 12px 0 12px;text-align:center;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ sa_cta_url }}" style="height:52px;v-text-anchor:middle;width:270px;" arcsize="50%" stroke="f" fillcolor="{{ sa_teal }}">
        <w:anchorlock/>
        <center style="color:#000000;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ sa_cta_text }}&nbsp;&nbsp;&#8594;</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ sa_cta_url }}" target="_blank" style="display:inline-block;background-color:{{ sa_teal }};border-radius:999px;padding:16px 30px 16px 34px;font-family:{{ sa_font }};font-size:15px;line-height:20px;font-weight:700;color:#000000;text-decoration:none;">{{ sa_cta_text }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:#000000;">&#8594;</span></a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ===================== NOTĂ ===================== -->
  <tr>
    <td align="center" style="padding:16px 24px 32px 24px;text-align:center;font-family:{{ sa_font }};font-size:12px;line-height:18px;font-weight:400;color:#75797C;">{{ sa_note }}</td>
  </tr>

</table>
