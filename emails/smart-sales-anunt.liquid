<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ sa_bg }}" style="background-color:{{ sa_bg }};">
  <tr>
    <td class="sa-wrap" align="center" style="padding:24px 16px 0 16px;text-align:center;">

      {%- if sa_show_hero %}
      <!-- ===================== BLOC TURCOAZ ===================== -->
      <!--[if mso]><table role="presentation" width="568" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td bgcolor="{{ sa_teal }}" style="padding:32px 24px;"><![endif]-->
      <div class="sa-hero" style="max-width:568px;margin:0 auto;background-color:{{ sa_teal }};border-radius:24px;padding:34px 24px 30px 24px;text-align:center;">
        <div style="font-family:{{ sa_font }};font-size:12px;line-height:14px;font-weight:700;letter-spacing:3px;color:{{ sa_ink }};text-transform:uppercase;"><span style="font-size:14px;">&#9679;</span>&nbsp; {{ sa_label | upcase }}</div>
        <div style="padding-top:14px;font-family:{{ sa_font }};font-size:22px;line-height:28px;font-weight:700;color:{{ sa_ink }};">{{ sa_line_1 }}</div>
        <div class="sa-big" style="font-family:{{ sa_font }};font-size:84px;line-height:88px;font-weight:800;color:{{ sa_ink }};white-space:nowrap;">{{ sa_disc }}<span style="font-size:0.55em;">%</span></div>
        <div style="padding-top:6px;font-size:0;line-height:0;"><div style="display:inline-block;max-width:420px;vertical-align:top;font-family:{{ sa_font }};font-size:16px;line-height:24px;font-weight:600;color:{{ sa_ink }};">{{ sa_text }}</div></div>
        <div style="padding-top:18px;"><span style="display:inline-block;background-color:#FFFFFF;border-radius:999px;padding:10px 18px;font-family:{{ sa_font }};font-size:14px;line-height:18px;font-weight:700;color:{{ sa_ink }};">{{ sa_until }}</span></div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
      {%- endif %}

      <!-- ===================== CIFRE ===================== -->
      <div style="max-width:580px;margin:0 auto;padding-top:{% if sa_show_hero %}12{% else %}4{% endif %}px;font-size:0;line-height:0;text-align:center;">
        <!--[if mso]><table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
        {%- for sa_s in sa_stat_list -%}
          {%- unless sa_s contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sa_sp = sa_s | split: "|" %}
        <!--[if mso]><td width="193" valign="top"><![endif]-->
        <div style="display:inline-block;width:33.33%;vertical-align:top;">
          <div style="padding:0 4px;">
            <div style="background-color:#FFFFFF;border:1px solid {{ sa_line }};border-radius:16px;padding:14px 4px 12px 4px;text-align:center;">
              <div class="sa-stat-num" style="font-family:{{ sa_font }};font-size:28px;line-height:34px;font-weight:800;color:{{ sa_ink }};white-space:nowrap;">{{ sa_sp[0] | strip }}</div>
              <div class="sa-stat-lbl" style="padding-top:2px;font-family:{{ sa_font }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:0.5px;color:#5F676C;text-transform:uppercase;">{{ sa_sp[1] | strip }}</div>
            </div>
          </div>
        </div>
        <!--[if mso]></td><![endif]-->
        {%- endfor %}
        <!--[if mso]></tr></table><![endif]-->
      </div>

      <!-- ===================== PRODUSE ===================== -->
      <div style="max-width:572px;margin:0 auto;padding-top:34px;text-align:center;">
        <div style="font-family:{{ sa_font }};font-size:22px;line-height:28px;font-weight:800;color:{{ sa_ink }};">{{ sa_list_head }}</div>
        <div style="padding-top:6px;font-family:{{ sa_font }};font-size:14px;line-height:20px;font-weight:400;color:#5F676C;">{{ sa_list_text }}</div>
      </div>

      {%- for sa_item in sa_lista -%}
        {%- unless sa_item contains "|" -%}{%- continue -%}{%- endunless -%}
        {%- assign sa_f      = sa_item | append: " | | | " | split: "|" -%}
        {%- assign sa_cat    = sa_f[0] | strip | upcase | escape -%}
        {%- assign sa_title2 = sa_f[1] | strip -%}
        {%- if sa_title2.size > sa_title_max -%}
          {%- assign sa_cut   = sa_title2 | slice: 0, sa_title_max -%}
          {%- assign sa_next  = sa_title2 | slice: sa_title_max, 1 -%}
          {%- assign sa_last  = sa_cut | slice: -1 -%}
          {%- if sa_next == " " or sa_last == " " -%}
            {%- assign sa_title2 = sa_cut | strip -%}
          {%- else -%}
            {%- assign sa_words = sa_cut | split: " " -%}
            {%- assign sa_title2 = "" -%}
            {%- for sa_w in sa_words -%}
              {%- unless forloop.last -%}{%- assign sa_title2 = sa_title2 | append: sa_w | append: " " -%}{%- endunless -%}
            {%- endfor -%}
            {%- assign sa_title2 = sa_title2 | strip -%}
          {%- endif -%}
          {%- assign sa_lc = sa_title2 | slice: -1 -%}
          {%- if sa_lc == "+" or sa_lc == "," or sa_lc == "-" or sa_lc == "–" or sa_lc == ":" or sa_lc == "(" -%}
            {%- assign sa_len    = sa_title2.size | minus: 1 -%}
            {%- assign sa_title2 = sa_title2 | slice: 0, sa_len | strip -%}
          {%- endif -%}
          {%- if sa_title2 == "" -%}{%- assign sa_title2 = sa_cut -%}{%- endif -%}
          {%- assign sa_title2 = sa_title2 | append: "…" -%}
        {%- endif -%}
        {%- assign sa_title2 = sa_title2 | escape -%}
        {%- assign sa_alt    = sa_f[1] | strip | escape -%}
        {%- assign sa_img    = sa_f[2] | strip -%}
        {%- assign sa_url    = sa_f[3] | strip -%}
        {%- assign sa_new_c  = sa_f[4] | strip | times: 100 | round -%}
        {%- assign sa_old_c  = sa_f[5] | strip | times: 100 | round -%}
        {%- assign sa_rate   = sa_f[6] | strip -%}
        {%- assign sa_revs   = sa_f[7] | strip -%}
        {%- assign sa_badge  = "" -%}
        {%- if sa_old_c > sa_new_c -%}
          {%- assign sa_pct   = sa_old_c | minus: sa_new_c | times: 100.0 | divided_by: sa_old_c | round -%}
          {%- assign sa_badge = "-" | append: sa_pct | append: "%" -%}
        {%- endif -%}
        {%- comment -%} formatare prețuri: 15999 → 159,99 ; 434673 → 4.346,73 {%- endcomment -%}
        {%- assign sa_fmt_in  = sa_new_c | append: "~" | append: sa_old_c | split: "~" -%}
        {%- assign sa_fmt_out = "" -%}
        {%- for sa_v in sa_fmt_in -%}
          {%- assign sa_c  = sa_v | plus: 0 -%}
          {%- assign sa_i  = sa_c | divided_by: 100 | floor -%}
          {%- assign sa_d  = sa_c | modulo: 100 -%}
          {%- if sa_d < 10 -%}{%- assign sa_ds = sa_d | prepend: "0" -%}{%- else -%}{%- assign sa_ds = sa_d | append: "" -%}{%- endif -%}
          {%- if sa_i >= 1000 -%}
            {%- assign sa_th = sa_i | divided_by: 1000 | floor -%}
            {%- assign sa_r  = sa_i | modulo: 1000 -%}
            {%- if sa_r < 10 -%}{%- assign sa_rs = sa_r | prepend: "00" -%}{%- elsif sa_r < 100 -%}{%- assign sa_rs = sa_r | prepend: "0" -%}{%- else -%}{%- assign sa_rs = sa_r | append: "" -%}{%- endif -%}
            {%- assign sa_is = sa_th | append: "." | append: sa_rs -%}
          {%- else -%}
            {%- assign sa_is = sa_i | append: "" -%}
          {%- endif -%}
          {%- assign sa_fmt_out = sa_fmt_out | append: sa_is | append: "," | append: sa_ds | append: "~" -%}
        {%- endfor -%}
        {%- assign sa_pf = sa_fmt_out | split: "~" -%}
        {%- comment -%} stele: nota rotunjită (4.8 → 5) {%- endcomment -%}
        {%- assign sa_full = 0 -%}
        {%- if sa_rate != "" -%}{%- assign sa_full = sa_rate | plus: 0 | round -%}{%- endif -%}
        {%- assign sa_rate_txt = sa_rate | replace: ".", "," -%}
      <!-- ===== produs ===== -->
      <div style="max-width:572px;margin:0 auto;padding-top:{% if forloop.first %}16{% else %}10{% endif %}px;text-align:left;">
        <div class="sa-card" style="background-color:#FFFFFF;border:1px solid {{ sa_line }};border-radius:18px;padding:12px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="table-layout:fixed;">
            <tr>
              <td class="sa-imgcell" width="112" valign="middle" style="width:112px;vertical-align:middle;">
                <a href="{{ sa_url }}" target="_blank" style="text-decoration:none;"><img class="sa-img" src="{{ sa_img }}" width="104" height="104" alt="{{ sa_alt }}" style="display:block;width:104px;height:104px;border:1px solid #EEF2F3;border-radius:12px;outline:none;text-decoration:none;"></a>
              </td>
              <td class="sa-info" valign="middle" style="vertical-align:middle;padding-left:14px;">
                <div style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ sa_font }};font-size:10px;line-height:18px;font-weight:700;letter-spacing:1px;color:{{ sa_teal_dark }};">{% if sa_badge != "" %}<span style="display:inline-block;background-color:{{ sa_red }};border-radius:6px;padding:1px 6px;font-size:11px;line-height:16px;font-weight:800;letter-spacing:0;color:#FFFFFF;vertical-align:top;">{{ sa_badge }}</span>&nbsp; {% endif %}{{ sa_cat }}</div>
                <div class="sa-title" style="margin-top:5px;height:38px;overflow:hidden;font-family:{{ sa_font }};font-size:14px;line-height:19px;font-weight:600;color:{{ sa_ink }};"><a href="{{ sa_url }}" target="_blank" style="color:{{ sa_ink }};text-decoration:none;">{{ sa_title2 }}</a></div>
                <div style="margin-top:4px;white-space:nowrap;font-family:{{ sa_font }};font-size:12px;line-height:16px;font-weight:400;color:#5F676C;">{% if sa_full > 0 %}<span style="font-family:Arial,Helvetica,sans-serif;font-size:13px;letter-spacing:1px;color:{{ sa_star }};">{% for sa_k in (1..5) %}{% if sa_k <= sa_full %}&#9733;{% else %}<span style="color:#D3D9DB;">&#9733;</span>{% endif %}{% endfor %}</span>&nbsp; <span style="font-weight:700;color:{{ sa_ink }};">{{ sa_rate_txt }}</span>{% if sa_revs != "" %} ({{ sa_revs }}){% endif %}{% else %}&nbsp;{% endif %}</div>
                <div style="margin-top:6px;font-size:0;line-height:0;">
                  <div style="display:inline-block;vertical-align:middle;margin:0 12px 6px 0;font-family:{{ sa_font }};font-size:14px;line-height:24px;">
                    <span class="sa-price" style="font-size:18px;font-weight:800;color:{{ sa_red }};white-space:nowrap;">{{ sa_pf[0] }} {{ sa_currency }}</span>{% if sa_old_c > sa_new_c %}&nbsp; <span style="font-size:13px;font-weight:400;color:#8A9095;text-decoration:line-through;white-space:nowrap;">{{ sa_pf[1] }} {{ sa_currency }}</span>{% endif %}
                  </div><div style="display:inline-block;vertical-align:middle;margin:0 0 6px 0;"><a href="{{ sa_url }}" target="_blank" style="display:inline-block;background-color:{{ sa_ink }};border-radius:999px;padding:8px 16px;font-family:{{ sa_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;">{{ sa_card_cta }}&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;color:{{ sa_teal }};">&#8594;</span></a></div>
                </div>
              </td>
            </tr>
          </table>
        </div>
      </div>
      {%- endfor %}

      <!-- ===================== STOCURI ===================== -->
      <div style="max-width:572px;margin:0 auto;padding-top:18px;text-align:left;">
        <div style="border:2px solid {{ sa_teal }};border-radius:18px;padding:14px 18px;background-color:#FFFFFF;">
          <div style="font-family:{{ sa_font }};font-size:15px;line-height:21px;font-weight:800;color:{{ sa_ink }};">{{ sa_stock_head }}</div>
          <div style="padding-top:2px;font-family:{{ sa_font }};font-size:14px;line-height:20px;font-weight:400;color:#41484D;">{{ sa_stock_text }}</div>
        </div>
      </div>

    </td>
  </tr>

  <!-- ===================== BUTON ===================== -->
  <tr>
    <td align="center" style="padding:26px 12px 0 12px;text-align:center;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ sa_cta_url }}" style="height:52px;v-text-anchor:middle;width:330px;" arcsize="50%" stroke="f" fillcolor="{{ sa_ink }}">
        <w:anchorlock/>
        <center style="color:#FFFFFF;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ sa_cta_text }}&nbsp;&nbsp;&#8594;</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ sa_cta_url }}" target="_blank" style="display:inline-block;background-color:{{ sa_ink }};border-radius:999px;padding:16px 30px 16px 34px;font-family:{{ sa_font }};font-size:15px;line-height:20px;font-weight:700;color:#FFFFFF;text-decoration:none;">{{ sa_cta_text }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:{{ sa_teal }};">&#8594;</span></a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ===================== NOTĂ ===================== -->
  <tr>
    <td align="center" style="padding:16px 24px 32px 24px;text-align:center;font-family:{{ sa_font }};font-size:12px;line-height:18px;font-weight:400;color:#6B7378;">{{ sa_note }}</td>
  </tr>

</table>
