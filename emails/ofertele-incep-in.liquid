<!--<![endif]-->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ cd_bg }}" style="background-color:{{ cd_bg }};">
  <tr>
    <td align="center" style="padding:32px 12px 6px 12px;text-align:center;font-family:{{ cd_font }};font-size:13px;line-height:16px;font-weight:700;letter-spacing:2px;color:#A3A6A8;text-transform:uppercase;">{{ cd_text | upcase }}</td>
  </tr>
</table>
