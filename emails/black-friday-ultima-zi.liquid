{%- assign bf_lista = bf_produse | split: "##" -%}

{%- comment -%} ===== 3. ȘABLON (nu e nevoie să modifici mai jos) ===== {%- endcomment -%}
<!--[if !mso]><!-->
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" rel="stylesheet">
<!--<![endif]-->
<style>
  @media only screen and (max-width: 480px) {
    .bfs-col { width: 50% !important; max-width: 50% !important; }
    .bfs-card { padding: 8px !important; }
    .bfs-cta { font-size: 12px !important; padding: 10px 2px !important; }
    .bfs-price { font-size: 15px !important; }
    .bfs-old { font-size: 11px !important; }
  }
  @media only screen and (max-width: 350px) {
    .bfs-old { display: block !important; }
  }
</style>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ bf_bg }}" style="background-color:{{ bf_bg }};">

  <!-- ===================== PASTILĂ + TITLU ===================== -->
  <tr>
    <td align="center" style="padding:32px 20px 0 20px;text-align:center;">
      <span style="display:inline-block;background-color:{{ bf_red }};border-radius:999px;padding:6px 14px;font-family:{{ bf_font }};font-size:12px;line-height:14px;font-weight:700;letter-spacing:2px;color:#FFFFFF;text-transform:uppercase;"><span style="font-size:14px;">&#9679;</span>&nbsp; {{ bf_pill | upcase }}</span>
      <div style="padding-top:16px;font-family:{{ bf_font }};font-size:38px;line-height:44px;font-weight:800;color:#FFFFFF;">{{ bf_title }}</div>
      <div style="padding-top:6px;font-family:{{ bf_font }};font-size:22px;line-height:29px;font-weight:700;color:#FFFFFF;">{{ bf_sub_1 }} <span style="color:{{ bf_teal }};white-space:nowrap;">{{ bf_sub_2 }}</span></div>
      <div style="max-width:470px;margin:0 auto;padding-top:12px;font-family:{{ bf_font }};font-size:15px;line-height:23px;font-weight:400;color:#A3A6A8;">{{ bf_text }}</div>
    </td>
  </tr>
  <!-- ===================== PRODUSE ===================== -->
  <tr>
    <td align="center" style="padding:30px 20px 0 20px;text-align:center;">
      <div style="font-family:{{ bf_font }};font-size:20px;line-height:26px;font-weight:700;color:#FFFFFF;">{{ bf_grid_head }}</div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 6px 0 6px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign bf_n = 0 -%}
        {%- for bf_item in bf_lista -%}
          {%- unless bf_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign bf_f      = bf_item | split: "|" -%}
          {%- assign bf_vendor = bf_f[0] | strip | replace: "_", " " | upcase | truncate: 20, "…" | escape -%}
          {%- assign bf_title2 = bf_f[1] | strip -%}
          {%- if bf_title2.size > bf_title_max -%}
            {%- assign bf_cut   = bf_title2 | slice: 0, bf_title_max -%}
            {%- assign bf_words = bf_cut | split: " " -%}
            {%- assign bf_title2 = "" -%}
            {%- for bf_w in bf_words -%}
              {%- unless forloop.last -%}{%- assign bf_title2 = bf_title2 | append: bf_w | append: " " -%}{%- endunless -%}
            {%- endfor -%}
            {%- assign bf_title2 = bf_title2 | strip -%}
            {%- assign bf_lc = bf_title2 | slice: -1 -%}
            {%- if bf_lc == "+" or bf_lc == "," or bf_lc == "-" or bf_lc == "–" or bf_lc == ":" -%}
              {%- assign bf_len    = bf_title2.size | minus: 1 -%}
              {%- assign bf_title2 = bf_title2 | slice: 0, bf_len | strip -%}
            {%- endif -%}
            {%- if bf_title2 == "" -%}{%- assign bf_title2 = bf_cut -%}{%- endif -%}
            {%- assign bf_title2 = bf_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign bf_title2 = bf_title2 | escape -%}
          {%- assign bf_alt    = bf_f[1] | strip | escape -%}
          {%- assign bf_img    = bf_f[2] | strip -%}
          {%- assign bf_url    = bf_f[3] | strip -%}
          {%- assign bf_p_new  = bf_f[4] | strip -%}
          {%- assign bf_p_old  = bf_f[5] | strip -%}
          {%- assign bf_new_n  = bf_p_new | plus: 0 -%}
          {%- assign bf_old_n  = bf_p_old | plus: 0 -%}
          {%- assign bf_badge  = "Black Friday" -%}
          {%- if bf_old_n > bf_new_n -%}
            {%- assign bf_pct   = bf_old_n | minus: bf_new_n | times: 100 | divided_by: bf_old_n | round -%}
            {%- assign bf_badge = "-" | append: bf_pct | append: "%" -%}
          {%- endif -%}
          {%- assign bf_p_new_txt = bf_p_new | replace: ".", "," | append: " " | append: bf_currency -%}
          {%- assign bf_p_old_txt = bf_p_old | replace: ".", "," | append: " " | append: bf_currency -%}
          {%- assign bf_n      = bf_n | plus: 1 -%}
          {%- assign bf_mod    = bf_n | modulo: 3 -%}
          {%- if bf_n > 1 and bf_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="180" valign="top"><![endif]-->
          <div class="bfs-col" style="display:inline-block;width:100%;max-width:180px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="bfs-card" style="background-color:#FFFFFF;border-radius:14px;padding:10px;">
                <!-- badge reducere -->
                <span style="display:inline-block;background-color:{{ bf_red }};border-radius:7px;padding:4px 8px;font-family:{{ bf_font }};font-size:13px;line-height:15px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ bf_badge }}</span>
                <!-- imagine -->
                <div style="margin-top:6px;height:148px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ bf_url }}" target="_blank" style="text-decoration:none;"><img src="{{ bf_img }}" width="148" alt="{{ bf_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:148px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <!-- brand -->
                <div style="padding-top:12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ bf_font }};font-size:11px;line-height:14px;font-weight:600;letter-spacing:1px;color:#646C71;">{{ bf_vendor }}</div>
                <!-- titlu (max. 2 rânduri) -->
                <div style="margin-top:6px;height:38px;overflow:hidden;font-family:{{ bf_font }};font-size:13px;line-height:19px;font-weight:400;color:#404040;"><a href="{{ bf_url }}" target="_blank" style="color:#404040;text-decoration:none;">{{ bf_title2 }}</a></div>
                <!-- preț -->
                <div class="bfs-price" style="padding-top:8px;white-space:nowrap;font-family:{{ bf_font }};font-size:16px;line-height:20px;font-weight:800;color:{{ bf_red }};">{{ bf_p_new_txt }}{% if bf_old_n > bf_new_n %} <span class="bfs-old" style="font-size:12px;font-weight:400;color:#8A9095;text-decoration:line-through;">{{ bf_p_old_txt }}</span>{% endif %}</div>
                <!-- buton card -->
                <div style="padding-top:10px;">
                  <div style="background-color:#000000;border-radius:8px;text-align:center;overflow:hidden;">
                    <a class="bfs-cta" href="{{ bf_url }}" target="_blank" style="display:block;padding:10px 6px;font-family:{{ bf_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;">{{ bf_card_cta }}&nbsp;<span style="color:{{ bf_teal }};font-family:Arial,Helvetica,sans-serif;">&#8594;</span></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== BUTON ===================== -->
  <tr>
    <td align="center" style="padding:24px 12px 0 12px;text-align:center;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ bf_cta_url }}" style="height:50px;v-text-anchor:middle;width:270px;" arcsize="50%" stroke="f" fillcolor="{{ bf_red }}">
        <w:anchorlock/>
        <center style="color:{{ bf_cta_color }};font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ bf_cta_text }}&nbsp;&nbsp;&#8594;</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ bf_cta_url }}" target="_blank" style="display:inline-block;background-color:{{ bf_red }};border-radius:999px;padding:15px 34px 15px 40px;font-family:{{ bf_font }};font-size:15px;line-height:20px;font-weight:700;color:{{ bf_cta_color }};text-decoration:none;">{{ bf_cta_text }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:{{ bf_cta_color }};">&#8594;</span></a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ===================== NOTĂ ===================== -->
  <tr>
    <td align="center" style="padding:16px 24px 36px 24px;text-align:center;font-family:{{ bf_font }};font-size:12px;line-height:18px;font-weight:400;color:#75797C;">{{ bf_note }}</td>
  </tr>

</table>
