      <div style="padding-top:12px;font-size:0;line-height:0;"><div style="display:inline-block;max-width:460px;vertical-align:top;font-family:{{ sc_font }};font-size:15px;line-height:23px;font-weight:400;color:{{ sc_muted }};">{{ sc_text }}</div></div>
      <div style="max-width:580px;margin:0 auto;padding-top:20px;font-size:0;line-height:0;text-align:center;">
        <!--[if mso]><table role="presentation" width="580" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
        {%- for sc_s in sc_step_list -%}
          {%- unless sc_s contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sc_sp = sc_s | split: "|" %}
