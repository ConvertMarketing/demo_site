        <div style="padding-top:2px;font-family:{{ sc_font }};font-size:21px;line-height:27px;font-weight:800;color:{{ sc_ink }};">{{ sc_name }}</div>
        <div style="padding-top:2px;font-family:{{ sc_font }};font-size:13px;line-height:19px;font-weight:400;color:#5F676C;">{{ sc_desc }}</div>
        <!-- produse -->
        <div style="padding-top:14px;font-size:0;line-height:0;">
          <!--[if mso]><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><![endif]-->
          {%- assign sc_j = 0 -%}
          {%- for sc_it in sc_parts offset:1 -%}
            {%- unless sc_it contains "|" -%}{%- continue -%}{%- endunless -%}
            {%- assign sc_f    = sc_it | split: "|" -%}
            {%- assign sc_nm   = sc_f[0] | strip | escape -%}
            {%- assign sc_img  = sc_f[1] | strip -%}
            {%- assign sc_purl = sc_f[2] | strip -%}
            {%- assign sc_q    = sc_f[4] | strip | plus: 0 -%}
            {%- assign sc_pi   = sc_j | times: 2 -%}
            {%- assign sc_po   = sc_pi | plus: 1 -%}
            {%- assign sc_nc   = sc_f[5] | strip | times: 100 | round -%}
            {%- assign sc_oc   = sc_f[6] | strip | times: 100 | round -%}
            {%- assign sc_j    = sc_j | plus: 1 %}
          <!--[if mso]><td valign="top" width="{{ sc_w }}%"><![endif]-->
          <div style="display:inline-block;width:{{ sc_w }}%;vertical-align:top;text-align:center;">
            <div style="padding:0 4px;">
              <a href="{{ sc_purl }}" target="_blank" style="text-decoration:none;"><img src="{{ sc_img }}" width="120" alt="{{ sc_nm }}" style="display:inline-block;width:100%;max-width:120px;height:auto;border:1px solid #EEF2F3;border-radius:12px;outline:none;text-decoration:none;vertical-align:top;"></a>
              <div class="sc-item-name" style="margin-top:6px;height:45px;overflow:hidden;font-family:{{ sc_font }};font-size:11.5px;line-height:15px;font-weight:600;color:{{ sc_ink }};">{% if sc_q > 1 %}{{ sc_q }} × {% endif %}{{ sc_nm }}</div>
              <div style="padding-top:4px;white-space:nowrap;font-family:{{ sc_font }};font-size:13px;line-height:17px;font-weight:800;color:{{ sc_red }};">{{ sc_fmt[sc_pi] }} {{ sc_currency }}</div>
              <div style="white-space:nowrap;font-family:{{ sc_font }};font-size:11px;line-height:14px;font-weight:400;color:#8A9095;">{% if sc_oc > sc_nc %}<span style="text-decoration:line-through;">{{ sc_fmt[sc_po] }} {{ sc_currency }}</span>{% else %}&nbsp;{% endif %}</div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
          {%- endfor %}
          <!--[if mso]></tr></table><![endif]-->
        </div>
        <!-- total -->
        <div style="margin-top:14px;border-top:1px dashed {{ sc_line }};font-size:0;line-height:0;">&nbsp;</div>
        <div style="padding-top:12px;font-size:0;line-height:0;">
          <div style="display:inline-block;vertical-align:middle;margin:0 12px 8px 0;">
            <div style="font-family:{{ sc_font }};font-size:11px;line-height:14px;font-weight:700;letter-spacing:1px;color:#5F676C;text-transform:uppercase;">{{ sc_total_lbl | upcase }}</div>
            <div style="white-space:nowrap;font-family:{{ sc_font }};font-size:14px;line-height:30px;font-weight:400;color:#8A9095;"><span class="sc-total" style="font-size:26px;line-height:30px;font-weight:800;color:{{ sc_ink }};">{{ sc_fmt[sc_ti] }} {{ sc_currency }}</span>&nbsp; <span style="text-decoration:line-through;">{{ sc_fmt[sc_oi] }}</span></div>
          </div><div style="display:inline-block;vertical-align:middle;margin:0 0 8px 0;"><span style="display:inline-block;background-color:{{ sc_teal_soft }};border-radius:999px;padding:7px 12px;font-family:{{ sc_font }};font-size:13px;line-height:16px;font-weight:800;color:{{ sc_teal_dark }};white-space:nowrap;">{{ sc_save_lbl }} {{ sc_fmt[sc_si] }} {{ sc_currency }}</span></div>
        </div>
        <!-- bara livrare gratuită -->
        <div style="padding-top:2px;font-family:{{ sc_font }};font-size:12px;line-height:16px;font-weight:700;color:{% if sc_left == 0 %}{{ sc_teal_dark }}{% else %}#5F676C{% endif %};">{% if sc_left == 0 %}&#10003;&nbsp; {{ sc_ship_ok }}{% else %}{{ sc_ship_more }} {{ sc_fmt[sc_li] }} {{ sc_currency }} pentru livrare gratuită{% endif %}</div>
        <div style="margin-top:6px;background-color:#E3E8EA;border-radius:999px;height:8px;font-size:0;line-height:0;overflow:hidden;">
          <div style="width:{{ sc_bar }}%;height:8px;background-color:{{ sc_teal }};border-radius:999px;font-size:0;line-height:0;">&nbsp;</div>
        </div>
        <!-- buton coș -->
        <div style="padding-top:16px;text-align:center;">
          <!--[if mso]>
          <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ sc_url }}" style="height:50px;v-text-anchor:middle;width:300px;" arcsize="50%" stroke="f" fillcolor="{{ sc_ink }}">
            <w:anchorlock/>
            <center style="color:#FFFFFF;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ sc_cos_cta }}&nbsp;&nbsp;&#8594;</center>
          </v:roundrect>
          <![endif]-->
          <!--[if !mso]><!-->
          <a href="{{ sc_url }}" target="_blank" style="display:block;background-color:{{ sc_ink }};border-radius:999px;padding:15px 10px;font-family:{{ sc_font }};font-size:15px;line-height:20px;font-weight:700;color:#FFFFFF;text-decoration:none;text-align:center;">{{ sc_cos_cta }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:{{ sc_teal }};">&#8594;</span></a>
          <!--<![endif]-->
          <div style="padding-top:8px;font-family:{{ sc_font }};font-size:11px;line-height:15px;font-weight:400;color:#8A9095;">{{ sc_cos_hint }}</div>
        </div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
  {%- endfor %}

  <!-- ===================== COMPLETEAZĂ COȘUL ===================== -->
  <tr>
    <td class="sc-wrap" align="center" style="padding:36px 16px 0 16px;text-align:center;">
      <div style="font-family:{{ sc_font }};font-size:22px;line-height:28px;font-weight:800;color:{{ sc_head }};">{{ sc_top_head }}</div>
      <div style="padding-top:6px;font-family:{{ sc_font }};font-size:14px;line-height:20px;font-weight:400;color:{{ sc_muted }};">{{ sc_top_text }}</div>
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:12px 6px 0 6px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign sc_n = 0 -%}
        {%- for sc_item in sc_top_list -%}
          {%- unless sc_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign sc_f      = sc_item | append: " | | | " | split: "|" -%}
          {%- assign sc_title2 = sc_f[0] | strip -%}
          {%- if sc_title2.size > sc_title_max -%}
            {%- assign sc_cut   = sc_title2 | slice: 0, sc_title_max -%}
            {%- assign sc_next  = sc_title2 | slice: sc_title_max, 1 -%}
            {%- assign sc_last  = sc_cut | slice: -1 -%}
            {%- if sc_next == " " or sc_last == " " -%}
              {%- assign sc_title2 = sc_cut | strip -%}
            {%- else -%}
              {%- assign sc_words = sc_cut | split: " " -%}
              {%- assign sc_title2 = "" -%}
              {%- for sc_w2 in sc_words -%}
                {%- unless forloop.last -%}{%- assign sc_title2 = sc_title2 | append: sc_w2 | append: " " -%}{%- endunless -%}
              {%- endfor -%}
              {%- assign sc_title2 = sc_title2 | strip -%}
            {%- endif -%}
            {%- assign sc_lc = sc_title2 | slice: -1 -%}
            {%- if sc_lc == "+" or sc_lc == "," or sc_lc == "-" or sc_lc == "–" or sc_lc == ":" or sc_lc == "(" -%}
              {%- assign sc_len    = sc_title2.size | minus: 1 -%}
              {%- assign sc_title2 = sc_title2 | slice: 0, sc_len | strip -%}
            {%- endif -%}
            {%- if sc_title2 == "" -%}{%- assign sc_title2 = sc_cut -%}{%- endif -%}
            {%- assign sc_title2 = sc_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign sc_title2 = sc_title2 | escape -%}
          {%- assign sc_alt    = sc_f[0] | strip | escape -%}
          {%- assign sc_img    = sc_f[1] | strip -%}
          {%- assign sc_purl   = sc_f[2] | strip -%}
          {%- assign sc_vid    = sc_f[3] | strip -%}
          {%- assign sc_nc     = sc_f[4] | strip | times: 100 | round -%}
          {%- assign sc_oc     = sc_f[5] | strip | times: 100 | round -%}
          {%- assign sc_rate   = sc_f[6] | strip -%}
          {%- assign sc_revs   = sc_f[7] | strip -%}
          {%- assign sc_badge  = "Smart Sales" -%}
          {%- if sc_oc > sc_nc -%}
            {%- assign sc_pct   = sc_oc | minus: sc_nc | times: 100.0 | divided_by: sc_oc | round -%}
            {%- assign sc_badge = "-" | append: sc_pct | append: "%" -%}
          {%- endif -%}
          {%- assign sc_fmt_in  = sc_nc | append: "~" | append: sc_oc | split: "~" -%}
          {%- assign sc_fmt_out = "" -%}
          {%- for sc_v in sc_fmt_in -%}
            {%- assign sc_c  = sc_v | plus: 0 -%}
            {%- assign sc_i  = sc_c | divided_by: 100 | floor -%}
            {%- assign sc_d  = sc_c | modulo: 100 -%}
            {%- if sc_d < 10 -%}{%- assign sc_ds = sc_d | prepend: "0" -%}{%- else -%}{%- assign sc_ds = sc_d | append: "" -%}{%- endif -%}
            {%- assign sc_is = sc_i | append: "" -%}
            {%- assign sc_fmt_out = sc_fmt_out | append: sc_is | append: "," | append: sc_ds | append: "~" -%}
          {%- endfor -%}
          {%- assign sc_pf = sc_fmt_out | split: "~" -%}
          {%- assign sc_full = 0 -%}
          {%- if sc_rate != "" -%}{%- assign sc_full = sc_rate | plus: 0 | round -%}{%- endif -%}
          {%- assign sc_rate_txt = sc_rate | replace: ".", "," -%}
          {%- assign sc_add = sc_shop | append: "/cart/add?id=" | append: sc_vid | append: "&quantity=1" -%}
          {%- assign sc_n   = sc_n | plus: 1 -%}
          {%- assign sc_mod = sc_n | modulo: 3 -%}
          {%- if sc_n > 1 and sc_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="180" valign="top"><![endif]-->
          <div class="sc-col" style="display:inline-block;width:100%;max-width:180px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="sc-card" style="background-color:#FFFFFF;border:1px solid {{ sc_line }};border-radius:16px;padding:10px;">
                <div style="font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ sc_red }};border-radius:7px;padding:3px 7px;font-family:{{ sc_font }};font-size:12px;line-height:15px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ sc_badge }}</span></div>
                <div style="margin-top:4px;height:116px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ sc_purl }}" target="_blank" style="text-decoration:none;"><img src="{{ sc_img }}" width="116" alt="{{ sc_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:116px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <div class="sc-title" style="margin-top:8px;height:36px;overflow:hidden;font-family:{{ sc_font }};font-size:13px;line-height:18px;font-weight:600;color:{{ sc_ink }};"><a href="{{ sc_purl }}" target="_blank" style="color:{{ sc_ink }};text-decoration:none;line-height:inherit;">{{ sc_title2 }}</a></div>
                <div style="margin-top:5px;height:16px;overflow:hidden;white-space:nowrap;font-family:{{ sc_font }};font-size:12px;line-height:16px;font-weight:400;color:#5F676C;">{% if sc_full > 0 %}<span class="sc-stars" style="font-family:Arial,Helvetica,sans-serif;font-size:12px;letter-spacing:1px;color:{{ sc_star }};">{% for sc_s in (1..5) %}{% if sc_s <= sc_full %}&#9733;{% else %}<span style="color:#D3D9DB;">&#9733;</span>{% endif %}{% endfor %}</span>&nbsp;<span style="font-weight:700;color:{{ sc_ink }};">{{ sc_rate_txt }}</span>{% if sc_revs != "" %} ({{ sc_revs }}){% endif %}{% else %}&nbsp;{% endif %}</div>
                <div style="padding-top:6px;white-space:nowrap;font-family:{{ sc_font }};font-size:12px;line-height:15px;font-weight:400;color:#8A9095;">{% if sc_oc > sc_nc %}<span style="text-decoration:line-through;">{{ sc_pf[1] }} {{ sc_currency }}</span>{% else %}&nbsp;{% endif %}</div>
                <div class="sc-price" style="white-space:nowrap;font-family:{{ sc_font }};font-size:17px;line-height:22px;font-weight:800;color:{{ sc_red }};">{{ sc_pf[0] }} {{ sc_currency }}</div>
                <div style="padding-top:10px;">
                  <div style="background-color:{{ sc_ink }};border-radius:999px;text-align:center;overflow:hidden;">
                    <a class="sc-cta" href="{{ sc_add }}" target="_blank" style="display:block;padding:9px 6px;font-family:{{ sc_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;"><span style="font-family:Arial,Helvetica,sans-serif;color:{{ sc_teal }};">+</span>&nbsp;{{ sc_top_cta }}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== SE ÎNCHEIE + BUTON ===================== -->
  <tr>
    <td class="sc-wrap" align="center" style="padding:20px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:center;">
        <div style="background-color:{{ sc_tile }};border:1px solid {{ sc_teal }};border-radius:999px;padding:12px 18px;font-family:{{ sc_font }};font-size:14px;line-height:20px;font-weight:400;color:#FFFFFF;">{{ sc_end_text }}</div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:22px 12px 0 12px;text-align:center;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ sc_cta_url }}" style="height:52px;v-text-anchor:middle;width:270px;" arcsize="50%" stroke="f" fillcolor="{{ sc_teal }}">
        <w:anchorlock/>
        <center style="color:#000000;font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ sc_cta_text }}&nbsp;&nbsp;&#8594;</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ sc_cta_url }}" target="_blank" style="display:inline-block;background-color:{{ sc_teal }};border-radius:999px;padding:16px 30px 16px 34px;font-family:{{ sc_font }};font-size:15px;line-height:20px;font-weight:700;color:#000000;text-decoration:none;">{{ sc_cta_text }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:#000000;">&#8594;</span></a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ===================== NOTĂ ===================== -->
  <tr>
    <td align="center" style="padding:16px 24px 32px 24px;text-align:center;font-family:{{ sc_font }};font-size:12px;line-height:18px;font-weight:400;color:#75797C;">{{ sc_note }}</td>
  </tr>

</table>
