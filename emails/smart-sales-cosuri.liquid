  <!-- ===================== COȘURI ===================== -->
  {%- assign sc_k = 0 -%}
  {%- for sc_cos in sc_cosuri -%}
    {%- assign sc_parts = sc_cos | split: "##" -%}
    {%- if sc_parts.size < 2 -%}{%- continue -%}{%- endif -%}
    {%- assign sc_hdr  = sc_parts[0] | append: " | " | split: "|" -%}
    {%- assign sc_name = sc_hdr[0] | strip -%}
    {%- assign sc_desc = sc_hdr[1] | strip -%}
    {%- assign sc_k = sc_k | plus: 1 -%}
    {%- comment -%} calcul: totaluri, link de coș, prețuri formatate {%- endcomment -%}
    {%- assign sc_sum_new = 0 -%}
    {%- assign sc_sum_old = 0 -%}
    {%- assign sc_link    = "" -%}
    {%- assign sc_vals    = "" -%}
    {%- assign sc_n       = 0 -%}
    {%- for sc_it in sc_parts offset:1 -%}
      {%- unless sc_it contains "|" -%}{%- continue -%}{%- endunless -%}
      {%- assign sc_f   = sc_it | split: "|" -%}
      {%- assign sc_vid = sc_f[3] | strip -%}
      {%- assign sc_q   = sc_f[4] | strip | plus: 0 -%}
      {%- if sc_q < 1 -%}{%- assign sc_q = 1 -%}{%- endif -%}
      {%- assign sc_nc  = sc_f[5] | strip | times: 100 | round -%}
      {%- assign sc_oc  = sc_f[6] | strip | times: 100 | round -%}
      {%- if sc_oc < sc_nc -%}{%- assign sc_oc = sc_nc -%}{%- endif -%}
      {%- assign sc_sum_new = sc_nc | times: sc_q | plus: sc_sum_new -%}
      {%- assign sc_sum_old = sc_oc | times: sc_q | plus: sc_sum_old -%}
      {%- if sc_link != "" -%}{%- assign sc_link = sc_link | append: "," -%}{%- endif -%}
      {%- assign sc_link = sc_link | append: sc_vid | append: ":" | append: sc_q -%}
      {%- assign sc_vals = sc_vals | append: sc_nc | append: "~" | append: sc_oc | append: "~" -%}
      {%- assign sc_n = sc_n | plus: 1 -%}
    {%- endfor -%}
    {%- if sc_n == 0 -%}{%- continue -%}{%- endif -%}
    {%- assign sc_save = sc_sum_old | minus: sc_sum_new -%}
    {%- assign sc_left = sc_free_c | minus: sc_sum_new -%}
    {%- if sc_left < 0 -%}{%- assign sc_left = 0 -%}{%- endif -%}
    {%- assign sc_bar = sc_sum_new | times: 100 | divided_by: sc_free_c -%}
    {%- if sc_bar > 100 -%}{%- assign sc_bar = 100 -%}{%- endif -%}
    {%- assign sc_bar = sc_bar | floor -%}
    {%- assign sc_vals = sc_vals | append: sc_sum_new | append: "~" | append: sc_sum_old | append: "~" | append: sc_save | append: "~" | append: sc_left -%}
    {%- assign sc_fmt_in  = sc_vals | split: "~" -%}
    {%- assign sc_fmt_out = "" -%}
    {%- for sc_v in sc_fmt_in -%}
      {%- assign sc_c  = sc_v | plus: 0 -%}
      {%- assign sc_i  = sc_c | divided_by: 100 | floor -%}
      {%- assign sc_d  = sc_c | modulo: 100 -%}
      {%- if sc_d < 10 -%}{%- assign sc_ds = sc_d | prepend: "0" -%}{%- else -%}{%- assign sc_ds = sc_d | append: "" -%}{%- endif -%}
      {%- if sc_i >= 1000 -%}
        {%- assign sc_th = sc_i | divided_by: 1000 | floor -%}
        {%- assign sc_r  = sc_i | modulo: 1000 -%}
        {%- if sc_r < 10 -%}{%- assign sc_rs = sc_r | prepend: "00" -%}{%- elsif sc_r < 100 -%}{%- assign sc_rs = sc_r | prepend: "0" -%}{%- else -%}{%- assign sc_rs = sc_r | append: "" -%}{%- endif -%}
        {%- assign sc_is = sc_th | append: "." | append: sc_rs -%}
      {%- else -%}
        {%- assign sc_is = sc_i | append: "" -%}
      {%- endif -%}
      {%- assign sc_fmt_out = sc_fmt_out | append: sc_is | append: "," | append: sc_ds | append: "~" -%}
    {%- endfor -%}
    {%- assign sc_fmt = sc_fmt_out | split: "~" -%}
    {%- assign sc_ti = sc_n | times: 2 -%}
    {%- assign sc_oi = sc_ti | plus: 1 -%}
    {%- assign sc_si = sc_ti | plus: 2 -%}
    {%- assign sc_li = sc_ti | plus: 3 -%}
    {%- assign sc_w  = 100 | divided_by: sc_n | floor -%}
    {%- assign sc_url = sc_shop | append: "/cart/" | append: sc_link | append: "?storefront=true" %}
  <tr>
    <td class="sc-wrap" align="center" style="padding:{% if sc_k == 1 %}30{% else %}16{% endif %}px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="568" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td bgcolor="#FFFFFF" style="padding:20px;"><![endif]-->
      <div class="sc-cos" style="display:inline-block;width:100%;max-width:568px;vertical-align:top;background-color:#FFFFFF;border-radius:20px;padding:20px 18px 18px 18px;box-sizing:border-box;text-align:left;">
        <!-- antet coș -->
