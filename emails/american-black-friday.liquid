<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="{{ ab_bg }}" style="background-color:{{ ab_bg }};">
  {%- comment -%} --- intro --- {%- endcomment %}
  <tr>
    <td class="ab-wrap" align="center" style="padding:30px 16px 0 16px;text-align:center;">
      <span style="display:inline-block;background-color:{{ ab_coral }};border-radius:999px;padding:7px 16px;font-family:{{ ab_font }};font-size:12px;line-height:14px;font-weight:800;letter-spacing:1.2px;color:#FFFFFF;text-transform:uppercase;">{{ ab_pill | upcase }}</span>
      <div class="ab-h1" style="padding-top:16px;font-family:{{ ab_font }};font-size:27px;line-height:35px;font-weight:800;color:{{ ab_head }};">{{ ab_title_1 }}<br><span style="color:{{ ab_hl }};">{{ ab_title_2 }}</span></div>
      <div style="padding-top:12px;font-size:0;line-height:0;"><div style="display:inline-block;max-width:470px;vertical-align:top;font-family:{{ ab_font }};font-size:15px;line-height:23px;font-weight:500;color:{{ ab_text }};">{{ ab_intro }}</div></div>
      <div style="max-width:480px;margin:0 auto;padding-top:20px;font-size:0;line-height:0;text-align:center;">
        <!--[if mso]><table role="presentation" width="480" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
        {%- for ab_x in ab_stats_list -%}
          {%- unless ab_x contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign ab_xp = ab_x | split: "|" %}
        <!--[if mso]><td width="160" valign="top"><![endif]-->
        <div style="display:inline-block;width:33.33%;vertical-align:top;">
          <div style="padding:0 3px;">
            <div style="background-color:{{ ab_tile }};border-radius:14px;padding:11px 2px 12px 2px;text-align:center;">
              <div style="font-family:{{ ab_font }};font-size:10px;line-height:13px;font-weight:700;letter-spacing:1px;color:{{ ab_teal_dark }};text-transform:uppercase;white-space:nowrap;">{{ ab_xp[0] | strip }}</div>
              <div class="ab-stat-big" style="padding-top:2px;font-family:{{ ab_font }};font-size:20px;line-height:24px;font-weight:800;color:{{ ab_text }};white-space:nowrap;">{{ ab_xp[1] | strip }}</div>
            </div>
          </div>
        </div>
        <!--[if mso]></td><![endif]-->
        {%- endfor %}
        <!--[if mso]></tr></table><![endif]-->
      </div>
