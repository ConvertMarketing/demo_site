            {%- assign hs_lc = hs_title2 | slice: -1 -%}
            {%- if hs_lc == "+" or hs_lc == "," or hs_lc == "-" or hs_lc == "–" or hs_lc == ":" or hs_lc == "(" -%}
              {%- assign hs_len    = hs_title2.size | minus: 1 -%}
              {%- assign hs_title2 = hs_title2 | slice: 0, hs_len | strip -%}
            {%- endif -%}
            {%- if hs_title2 == "" -%}{%- assign hs_title2 = hs_cut -%}{%- endif -%}
            {%- assign hs_title2 = hs_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign hs_title2 = hs_title2 | escape -%}
          {%- assign hs_alt    = hs_f[2] | strip | escape -%}
          {%- assign hs_img    = hs_f[3] | strip -%}
          {%- assign hs_url    = hs_f[4] | strip -%}
          {%- assign hs_new_c  = hs_f[5] | strip | times: 100 | round -%}
          {%- assign hs_old_c  = hs_f[6] | strip | times: 100 | round -%}
          {%- assign hs_badge  = "Smart Sales" -%}
          {%- if hs_old_c > hs_new_c -%}
            {%- assign hs_pct   = hs_old_c | minus: hs_new_c | times: 100.0 | divided_by: hs_old_c | round -%}
            {%- assign hs_badge = "-" | append: hs_pct | append: "%" -%}
          {%- endif -%}
          {%- comment -%} formatare prețuri: 434673 → 4.346,73 {%- endcomment -%}
          {%- assign hs_fmt_in  = hs_new_c | append: "~" | append: hs_old_c | split: "~" -%}
          {%- assign hs_fmt_out = "" -%}
          {%- for hs_v in hs_fmt_in -%}
            {%- assign hs_c  = hs_v | plus: 0 -%}
            {%- assign hs_i  = hs_c | divided_by: 100 | floor -%}
            {%- assign hs_d  = hs_c | modulo: 100 -%}
            {%- if hs_d < 10 -%}{%- assign hs_ds = hs_d | prepend: "0" -%}{%- else -%}{%- assign hs_ds = hs_d | append: "" -%}{%- endif -%}
            {%- if hs_i >= 1000 -%}
              {%- assign hs_th = hs_i | divided_by: 1000 | floor -%}
              {%- assign hs_r  = hs_i | modulo: 1000 -%}
              {%- if hs_r < 10 -%}{%- assign hs_rs = hs_r | prepend: "00" -%}{%- elsif hs_r < 100 -%}{%- assign hs_rs = hs_r | prepend: "0" -%}{%- else -%}{%- assign hs_rs = hs_r | append: "" -%}{%- endif -%}
              {%- assign hs_is = hs_th | append: "." | append: hs_rs -%}
            {%- else -%}
              {%- assign hs_is = hs_i | append: "" -%}
            {%- endif -%}
            {%- assign hs_fmt_out = hs_fmt_out | append: hs_is | append: "," | append: hs_ds | append: "~" -%}
          {%- endfor -%}
          {%- assign hs_pf = hs_fmt_out | split: "~" -%}
          {%- assign hs_n      = hs_n | plus: 1 -%}
          {%- assign hs_mod    = hs_n | modulo: 3 -%}
          {%- if hs_n > 1 and hs_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="180" valign="top"><![endif]-->
          <div class="hs-col" style="display:inline-block;width:100%;max-width:180px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="hs-card" style="background-color:{{ hs_card }};border:1px solid {{ hs_card_line }};border-radius:14px;padding:8px;">
                <!-- imagine + badge -->
                <div style="background-color:#FFFFFF;border-radius:10px;padding:8px;">
                  <div style="font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ hs_red }};border-radius:7px;padding:4px 8px;font-family:{{ hs_font }};font-size:13px;line-height:15px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ hs_badge }}</span></div>
                  <div style="margin-top:4px;height:124px;text-align:center;font-size:0;line-height:0;">
                    <a href="{{ hs_url }}" target="_blank" style="text-decoration:none;"><img src="{{ hs_img }}" width="124" alt="{{ hs_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:124px;border:0;outline:none;text-decoration:none;"></a>
                  </div>
                </div>
                <!-- categorie -->
                <div class="hs-cat" style="padding:12px 2px 0 2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ hs_font }};font-size:10px;line-height:13px;font-weight:700;letter-spacing:1px;color:{{ hs_teal }};">{{ hs_cat }}</div>
                <!-- titlu (max. 2 rânduri) -->
                <div style="margin:6px 2px 0 2px;height:38px;overflow:hidden;font-family:{{ hs_font }};font-size:13px;line-height:19px;font-weight:400;color:#FFFFFF;"><a href="{{ hs_url }}" target="_blank" style="color:#FFFFFF;text-decoration:none;">{{ hs_title2 }}</a></div>
                <!-- preț vechi + preț Smart Sales -->
                <div style="padding:8px 2px 0 2px;white-space:nowrap;font-family:{{ hs_font }};font-size:12px;line-height:15px;font-weight:400;color:#8A9095;">{% if hs_old_c > hs_new_c %}<span style="text-decoration:line-through;">{{ hs_pf[1] }} {{ hs_currency }}</span>{% else %}&nbsp;{% endif %}</div>
                <div class="hs-price" style="padding:1px 2px 0 2px;white-space:nowrap;font-family:{{ hs_font }};font-size:17px;line-height:22px;font-weight:800;color:{{ hs_teal }};">{{ hs_pf[0] }} {{ hs_currency }}</div>
                <!-- buton card -->
                <div style="padding-top:10px;">
                  <div style="background-color:{{ hs_teal }};border-radius:999px;text-align:center;overflow:hidden;">
                    <a class="hs-cta" href="{{ hs_url }}" target="_blank" style="display:block;padding:9px 6px;font-family:{{ hs_font }};font-size:13px;line-height:17px;font-weight:700;color:{{ hs_cta_color }};text-decoration:none;white-space:nowrap;">{{ hs_card_cta }}&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;">&#8594;</span></a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== MAGAZIN SNAGOV ===================== -->
  <tr>
    <td align="center" style="padding:22px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:left;">
        <div style="border:1px solid {{ hs_teal }};border-radius:14px;padding:14px 18px;">
          <div style="font-family:{{ hs_font }};font-size:15px;line-height:21px;font-weight:700;color:{{ hs_teal }};">{{ hs_store_head }}</div>
          <div style="padding-top:2px;font-family:{{ hs_font }};font-size:14px;line-height:20px;font-weight:400;color:#C9CCCE;">{{ hs_store_text }}</div>
        </div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>

  <!-- ===================== BUTON ===================== -->
  <tr>
    <td align="center" style="padding:28px 12px 0 12px;text-align:center;">
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ hs_cta_url }}" style="height:50px;v-text-anchor:middle;width:270px;" arcsize="50%" stroke="f" fillcolor="{{ hs_teal }}">
        <w:anchorlock/>
        <center style="color:{{ hs_cta_color }};font-family:Arial,sans-serif;font-size:15px;font-weight:bold;">{{ hs_cta_text }}&nbsp;&nbsp;&#8594;</center>
      </v:roundrect>
      <![endif]-->
      <!--[if !mso]><!-->
      <a href="{{ hs_cta_url }}" target="_blank" style="display:inline-block;background-color:{{ hs_teal }};border-radius:999px;padding:15px 34px 15px 40px;font-family:{{ hs_font }};font-size:15px;line-height:20px;font-weight:700;color:{{ hs_cta_color }};text-decoration:none;">{{ hs_cta_text }}&nbsp;&nbsp;<span style="font-family:Arial,Helvetica,sans-serif;font-size:18px;line-height:20px;font-weight:700;color:{{ hs_cta_color }};">&#8594;</span></a>
      <!--<![endif]-->
    </td>
  </tr>

  <!-- ===================== NOTĂ ===================== -->
  <tr>
    <td align="center" style="padding:16px 24px 36px 24px;text-align:center;font-family:{{ hs_font }};font-size:12px;line-height:18px;font-weight:400;color:#75797C;">{{ hs_note }}</td>
  </tr>

</table>
