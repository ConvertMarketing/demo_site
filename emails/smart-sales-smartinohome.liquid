          {%- assign hs_title2 = hs_f[2] | strip -%}
          {%- if hs_title2.size > hs_title_max -%}
            {%- assign hs_cut   = hs_title2 | slice: 0, hs_title_max -%}
            {%- assign hs_words = hs_cut | split: " " -%}
            {%- assign hs_title2 = "" -%}
            {%- for hs_w in hs_words -%}
              {%- unless forloop.last -%}{%- assign hs_title2 = hs_title2 | append: hs_w | append: " " -%}{%- endunless -%}
