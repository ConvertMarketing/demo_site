{%- comment -%} ===== 3. CALCUL BON (nu e nevoie să modifici) ===== {%- endcomment -%}
{%- assign hs_b_names = "" -%}
{%- assign hs_b_vals  = "" -%}
{%- assign hs_b_pcts  = "" -%}
{%- assign hs_b_old_sum = 0 -%}
{%- assign hs_b_new_sum = 0 -%}
{%- assign hs_b_n = 0 -%}
{%- for hs_item in hs_lista -%}
  {%- unless hs_item contains "|" -%}{%- continue -%}{%- endunless -%}
  {%- if hs_b_n >= hs_bon_count -%}{%- break -%}{%- endif -%}
  {%- assign hs_f     = hs_item | split: "|" -%}
  {%- assign hs_new_c = hs_f[5] | strip | times: 100 | round -%}
  {%- assign hs_old_c = hs_f[6] | strip | times: 100 | round -%}
  {%- if hs_old_c < hs_new_c -%}{%- assign hs_old_c = hs_new_c -%}{%- endif -%}
  {%- assign hs_b_old_sum = hs_b_old_sum | plus: hs_old_c -%}
  {%- assign hs_b_new_sum = hs_b_new_sum | plus: hs_new_c -%}
  {%- assign hs_disc_c = hs_old_c | minus: hs_new_c -%}
  {%- assign hs_pct = 0 -%}
  {%- if hs_old_c > 0 -%}{%- assign hs_pct = hs_disc_c | times: 100.0 | divided_by: hs_old_c | round -%}{%- endif -%}
  {%- assign hs_nm = hs_f[2] | strip | remove: '"' | upcase -%}
  {%- if hs_nm.size > 22 -%}
    {%- assign hs_cut   = hs_nm | slice: 0, 22 -%}
    {%- assign hs_next  = hs_nm | slice: 22, 1 -%}
    {%- assign hs_last  = hs_cut | slice: -1 -%}
    {%- if hs_next == " " or hs_last == " " -%}
      {%- assign hs_nm = hs_cut | strip -%}
    {%- else -%}
      {%- assign hs_words = hs_cut | split: " " -%}
      {%- assign hs_nm = "" -%}
      {%- for hs_w in hs_words -%}
        {%- unless forloop.last -%}{%- assign hs_nm = hs_nm | append: hs_w | append: " " -%}{%- endunless -%}
      {%- endfor -%}
      {%- assign hs_nm = hs_nm | strip -%}
    {%- endif -%}
    {%- assign hs_lc = hs_nm | slice: -1 -%}
    {%- if hs_lc == "," or hs_lc == "-" or hs_lc == "–" -%}
      {%- assign hs_len = hs_nm.size | minus: 1 -%}
      {%- assign hs_nm  = hs_nm | slice: 0, hs_len | strip -%}
    {%- endif -%}
    {%- if hs_nm == "" -%}{%- assign hs_nm = hs_cut -%}{%- endif -%}
    {%- assign hs_nm = hs_nm | append: "…" -%}
  {%- endif -%}
  {%- assign hs_b_names = hs_b_names | append: hs_nm | append: "~" -%}
  {%- assign hs_b_vals  = hs_b_vals | append: hs_old_c | append: "~" | append: hs_disc_c | append: "~" -%}
  {%- assign hs_b_pcts  = hs_b_pcts | append: hs_pct | append: "~" -%}
  {%- assign hs_b_n = hs_b_n | plus: 1 -%}
{%- endfor -%}
{%- assign hs_b_save_sum = hs_b_old_sum | minus: hs_b_new_sum -%}
{%- assign hs_b_vals = hs_b_vals | append: hs_b_new_sum | append: "~" | append: hs_b_save_sum -%}
{%- comment -%} formatare: 434673 → 4.346,73 {%- endcomment -%}
{%- assign hs_fmt_in  = hs_b_vals | split: "~" -%}
{%- assign hs_fmt_out = "" -%}
{%- for hs_v in hs_fmt_in -%}
  {%- assign hs_c  = hs_v | plus: 0 -%}
  {%- assign hs_i  = hs_c | divided_by: 100 | floor -%}
  {%- assign hs_d  = hs_c | modulo: 100 -%}
  {%- if hs_d < 10 -%}{%- assign hs_ds = hs_d | prepend: "0" -%}{%- else -%}{%- assign hs_ds = hs_d | append: "" -%}{%- endif -%}
  {%- if hs_i >= 1000 -%}
    {%- assign hs_th = hs_i | divided_by: 1000 | floor -%}
    {%- assign hs_r  = hs_i | modulo: 1000 -%}
    {%- if hs_r < 10 -%}{%- assign hs_rs = hs_r | prepend: "00" -%}{%- elsif hs_r < 100 -%}{%- assign hs_rs = hs_r | prepend: "0" -%}{%- else -%}{%- assign hs_rs = hs_r | append: "" -%}{%- endif -%}
    {%- assign hs_is = hs_th | append: "." | append: hs_rs -%}
  {%- else -%}
    {%- assign hs_is = hs_i | append: "" -%}
  {%- endif -%}
  {%- assign hs_fmt_out = hs_fmt_out | append: hs_is | append: "," | append: hs_ds | append: "~" -%}
{%- endfor -%}
{%- assign hs_b_fmt   = hs_fmt_out | split: "~" -%}
{%- assign hs_b_nm    = hs_b_names | split: "~" -%}
{%- assign hs_b_pc    = hs_b_pcts | split: "~" -%}
{%- assign hs_b_tot_i  = hs_b_n | times: 2 -%}
{%- assign hs_b_save_i = hs_b_tot_i | plus: 1 -%}

