      <!--[if mso]><table role="presentation" width="540" cellpadding="0" cellspacing="0" border="0" align="center"><tr><![endif]-->
      <div style="display:inline-block;width:100%;max-width:540px;vertical-align:top;font-size:0;line-height:0;text-align:center;">
        {%- assign ah_n = 0 -%}
        {%- for ah_item in ah_list -%}
          {%- unless ah_item contains "|" -%}{%- continue -%}{%- endunless -%}
          {%- assign ah_f      = ah_item | append: " | | | " | split: "|" -%}
          {%- assign ah_cat    = ah_f[0] | strip | escape -%}
          {%- assign ah_title2 = ah_f[1] | strip -%}
          {%- if ah_title2.size > ah_title_max -%}
            {%- assign ah_cut   = ah_title2 | slice: 0, ah_title_max -%}
            {%- assign ah_next  = ah_title2 | slice: ah_title_max, 1 -%}
            {%- assign ah_last  = ah_cut | slice: -1 -%}
            {%- if ah_next == " " or ah_last == " " -%}
              {%- assign ah_title2 = ah_cut | strip -%}
            {%- else -%}
              {%- assign ah_words = ah_cut | split: " " -%}
              {%- assign ah_title2 = "" -%}
              {%- for ah_w in ah_words -%}
                {%- unless forloop.last -%}{%- assign ah_title2 = ah_title2 | append: ah_w | append: " " -%}{%- endunless -%}
              {%- endfor -%}
              {%- assign ah_title2 = ah_title2 | strip -%}
            {%- endif -%}
            {%- assign ah_lc = ah_title2 | slice: -1 -%}
            {%- if ah_lc == "+" or ah_lc == "," or ah_lc == "-" or ah_lc == "–" or ah_lc == ":" or ah_lc == "(" -%}
              {%- assign ah_len    = ah_title2.size | minus: 1 -%}
              {%- assign ah_title2 = ah_title2 | slice: 0, ah_len | strip -%}
            {%- endif -%}
            {%- if ah_title2 == "" -%}{%- assign ah_title2 = ah_cut -%}{%- endif -%}
            {%- assign ah_title2 = ah_title2 | append: "…" -%}
          {%- endif -%}
          {%- assign ah_title2 = ah_title2 | escape -%}
          {%- assign ah_alt    = ah_f[1] | strip | escape -%}
          {%- assign ah_img    = ah_f[2] | strip -%}
          {%- assign ah_purl   = ah_f[3] | strip -%}
          {%- assign ah_vid    = ah_f[4] | strip -%}
          {%- assign ah_nc     = ah_f[5] | strip | times: 100 | round -%}
          {%- assign ah_oc     = ah_f[6] | strip | times: 100 | round -%}
          {%- assign ah_sc     = 0 -%}
          {%- assign ah_badge  = "Black Friday" -%}
          {%- if ah_oc > ah_nc -%}
            {%- assign ah_sc    = ah_oc | minus: ah_nc -%}
            {%- assign ah_pct   = ah_sc | times: 100.0 | divided_by: ah_oc | round -%}
            {%- assign ah_badge = "-" | append: ah_pct | append: "%" -%}
          {%- endif -%}
          {%- comment -%} formatare prețuri: 15999 → 159,99 ; 434673 → 4.346,73 {%- endcomment -%}
          {%- assign ah_fmt_in  = ah_nc | append: "~" | append: ah_oc | append: "~" | append: ah_sc | split: "~" -%}
          {%- assign ah_fmt_out = "" -%}
          {%- for ah_v in ah_fmt_in -%}
            {%- assign ah_c  = ah_v | plus: 0 -%}
            {%- assign ah_i  = ah_c | divided_by: 100 | floor -%}
            {%- assign ah_d  = ah_c | modulo: 100 -%}
            {%- if ah_d < 10 -%}{%- assign ah_ds = ah_d | prepend: "0" -%}{%- else -%}{%- assign ah_ds = ah_d | append: "" -%}{%- endif -%}
            {%- if ah_i >= 1000 -%}
              {%- assign ah_th = ah_i | divided_by: 1000 | floor -%}
              {%- assign ah_r  = ah_i | modulo: 1000 -%}
              {%- if ah_r < 10 -%}{%- assign ah_rs = ah_r | prepend: "00" -%}{%- elsif ah_r < 100 -%}{%- assign ah_rs = ah_r | prepend: "0" -%}{%- else -%}{%- assign ah_rs = ah_r | append: "" -%}{%- endif -%}
              {%- assign ah_is = ah_th | append: "." | append: ah_rs -%}
            {%- else -%}
              {%- assign ah_is = ah_i | append: "" -%}
            {%- endif -%}
            {%- assign ah_fmt_out = ah_fmt_out | append: ah_is | append: "," | append: ah_ds | append: "~" -%}
          {%- endfor -%}
          {%- assign ah_pf = ah_fmt_out | split: "~" -%}
          {%- assign ah_add = ah_shop | append: "/cart/add?id=" | append: ah_vid | append: "&quantity=1" -%}
          {%- assign ah_n   = ah_n | plus: 1 -%}
          {%- assign ah_mod = ah_n | modulo: 3 -%}
          {%- if ah_n > 1 and ah_mod == 1 -%}<!--[if mso]></tr><tr><![endif]-->{%- endif -%}
          <!--[if mso]><td width="172" valign="top"><![endif]-->
          <div class="ah-col" style="display:inline-block;width:100%;max-width:170px;vertical-align:top;font-size:14px;line-height:20px;text-align:left;">
            <div style="padding:6px;">
              <div class="ah-card" style="background-color:#FFFFFF;border:1px solid {{ ah_line }};border-radius:16px;padding:10px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
                  <td align="left" style="text-align:left;font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ ah_wine }};border-radius:7px;padding:3px 8px;font-family:{{ ah_font }};font-size:13px;line-height:16px;font-weight:800;color:#FFFFFF;white-space:nowrap;">{{ ah_badge }}</span></td>
                  {%- if ah_rank != "" %}
                  <td align="right" style="text-align:right;font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ ah_btn }};border-radius:7px;padding:3px 7px;font-family:{{ ah_font }};font-size:11px;line-height:16px;font-weight:800;letter-spacing:0.5px;color:#FFFFFF;white-space:nowrap;text-transform:uppercase;"><span style="font-family:Arial,Helvetica,sans-serif;color:{{ ah_teal }};">&#9733;</span> {{ ah_rank | upcase }}</span></td>
                  {%- endif %}
                </tr></table>
                <div class="ah-imgbox" style="margin-top:4px;height:124px;text-align:center;font-size:0;line-height:0;">
                  <a href="{{ ah_purl }}" target="_blank" style="text-decoration:none;"><img class="ah-img" src="{{ ah_img }}" width="124" alt="{{ ah_alt }}" style="display:inline-block;vertical-align:middle;width:auto;height:auto;max-width:100%;max-height:124px;border:0;outline:none;text-decoration:none;"></a>
                </div>
                <div class="ah-cat" style="margin-top:8px;height:15px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:{{ ah_font }};font-size:11px;line-height:15px;font-weight:700;color:{{ ah_teal_dark }};">{{ ah_cat }}</div>
                <div class="ah-title" style="margin-top:2px;height:36px;overflow:hidden;font-family:{{ ah_font }};font-size:12.5px;line-height:18px;font-weight:600;color:{{ ah_ink }};"><a href="{{ ah_purl }}" target="_blank" style="color:{{ ah_ink }};text-decoration:none;line-height:inherit;">{{ ah_title2 }}</a></div>
                <div style="padding-top:6px;white-space:nowrap;font-family:{{ ah_font }};font-size:12px;line-height:15px;font-weight:400;color:#8A9095;">{% if ah_oc > ah_nc %}<span style="text-decoration:line-through;">{{ ah_pf[1] }} {{ ah_currency }}</span>{% else %}&nbsp;{% endif %}</div>
                <div class="ah-price" style="white-space:nowrap;font-family:{{ ah_font }};font-size:17px;line-height:22px;font-weight:800;color:{{ ah_price }};">{{ ah_pf[0] }} {{ ah_currency }}</div>
                <div style="margin-top:8px;background-color:{{ ah_teal_soft }};border-radius:10px;padding:6px 8px;">
                  <div style="font-family:{{ ah_font }};font-size:9.5px;line-height:12px;font-weight:700;letter-spacing:1px;color:{{ ah_teal_dark }};text-transform:uppercase;white-space:nowrap;">{{ ah_save_lbl | upcase }}</div>
                  <div class="ah-save-amt" style="font-family:{{ ah_font }};font-size:14px;line-height:18px;font-weight:800;color:{{ ah_teal_dark }};white-space:nowrap;">{% if ah_sc > 0 %}{{ ah_pf[2] }} {{ ah_currency }}{% else %}&nbsp;{% endif %}</div>
                </div>
                <div style="padding-top:10px;">
                  <div style="background-color:{{ ah_btn }};border-radius:999px;text-align:center;overflow:hidden;">
                    <a class="ah-cta" href="{{ ah_add }}" target="_blank" style="display:block;padding:10px 6px;font-family:{{ ah_font }};font-size:13px;line-height:17px;font-weight:700;color:#FFFFFF;text-decoration:none;white-space:nowrap;"><span style="font-family:Arial,Helvetica,sans-serif;color:{{ ah_teal }};">+</span>&nbsp;{{ ah_card_cta }}</a>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <!--[if mso]></td><![endif]-->
        {%- endfor -%}
      </div>
      <!--[if mso]></tr></table><![endif]-->
    </td>
  </tr>
