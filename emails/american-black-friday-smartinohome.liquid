  <tr>
    <td class="ah-wrap" align="center" style="padding:30px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:center;">
        <div style="background-color:#FFFFFF;border-radius:20px;padding:20px 20px 20px 20px;text-align:center;">
          <div style="font-size:0;line-height:0;"><span style="display:inline-block;background-color:{{ ah_wine }};border-radius:999px;padding:5px 12px;font-family:{{ ah_font }};font-size:11px;line-height:14px;font-weight:800;letter-spacing:1.2px;color:#FFFFFF;text-transform:uppercase;">{{ ah_store_lbl | upcase }}</span></div>
          <div style="padding-top:10px;font-family:{{ ah_font }};font-size:15px;line-height:22px;font-weight:400;color:{{ ah_ink }};">{{ ah_store_text }}</div>
          <div style="padding-top:4px;font-family:{{ ah_font }};font-size:13px;line-height:19px;font-weight:400;color:#5F6366;">{{ ah_store_addr }}{% if ah_store_url != "" %} &middot; <a href="{{ ah_store_url }}" target="_blank" style="color:{{ ah_teal_dark }};font-weight:700;text-decoration:underline;">{{ ah_store_link }}&nbsp;&#8594;</a>{% endif %}</div>
        </div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
  {%- endif %}
  {%- comment -%} --- final --- {%- endcomment %}
  <tr>
    <td class="ah-wrap" align="center" style="padding:16px 16px 0 16px;text-align:center;font-size:0;line-height:0;">
      <!--[if mso]><table role="presentation" width="528" cellpadding="0" cellspacing="0" border="0" align="center"><tr><td><![endif]-->
      <div style="display:inline-block;width:100%;max-width:528px;vertical-align:top;text-align:center;">
        <div style="background-color:{{ ah_tile }};border:1px solid {{ ah_teal }};border-radius:999px;padding:12px 18px;font-family:{{ ah_font }};font-size:14px;line-height:20px;font-weight:400;color:#FFFFFF;">{{ ah_end_text }}</div>
      </div>
      <!--[if mso]></td></tr></table><![endif]-->
    </td>
  </tr>
  <tr>
    <td align="center" style="padding:22px 12px 0 12px;text-align:center;">
